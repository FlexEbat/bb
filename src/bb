units_install() {
	local u tmp
	mkdir -p -- "$UNIT_DIR" || return 1
	for u in $UNIT_NAMES; do
		[[ $u == bb-sets.service && ${CFG[backend]} != iptables ]] && continue
		tmp=$UNIT_DIR/$u.new
		unit_text "$u" >"$tmp" && chmod 0644 "$tmp" && mv -f -- "$tmp" "$UNIT_DIR/$u" || return 1
	done
	[[ ${CFG[backend]} == iptables ]] || rm -f -- "$UNIT_DIR/bb-sets.service"
	systemctl daemon-reload >/dev/null 2>&1 || true
	digest_timer_sync
	systemctl enable bb-firewall.service bb-update.timer bb-guard.timer >/dev/null 2>&1 || return 1
	[[ ${CFG[backend]} == iptables ]] && { systemctl enable bb-sets.service >/dev/null 2>&1 || return 1; }
	return 0
}

# ---- self-check: prints one problem per line -----------------------------------------
selfcheck() {
	local out kind a b c u s
	if ! fw_check >/dev/null 2>&1; then t chk_rules_inactive; printf '\n'; fi
	out=$(fw_status 2>/dev/null)
	while read -r kind a b c; do
		[[ $kind == set && $b == - ]] && { t chk_set_missing "$a"; printf '\n'; }
	done <<<"$out"
	for s in dht flow; do
		grep -q "^counter $s " <<<"$out" || { t chk_rules_missing "$s"; printf '\n'; }
	done
	if have ipset; then
		for s in $(ipset list -n 2>/dev/null | grep '^bb_tmp_'); do t chk_stale_set "$s"; printf '\n'; done
	fi
	for u in bb-firewall.service bb-update.timer bb-guard.timer; do
		systemctl is-enabled --quiet "$u" 2>/dev/null || { t chk_unit_disabled "$u"; printf '\n'; }
	done
	[[ ${CFG[backend]} == iptables ]] && { systemctl is-enabled --quiet bb-sets.service 2>/dev/null || { t chk_unit_disabled bb-sets.service; printf '\n'; }; }
	return 0
}

ask() { # prompt default -> answer on stdout
	local ans=""
	read -r -p "$1" ans
	printf '%s\n' "${ans:-$2}"
}

install_choose_lang() { # $1 = interactive (0/1)
	local lang=${ARG_LANG:-} def ans
	if [[ -z $lang ]]; then
		lang=${CFG[lang]}
		if (($1)); then
			def=en
			[[ ${LC_ALL:-${LANG:-}} == ru* ]] && def=ru
			printf 'Language / Язык: 1) English  2) Русский [%s]: ' "$def" >&2 # bb-lint: ok
			read -r ans
			case $ans in 1) lang=en ;; 2) lang=ru ;; *) lang=$def ;; esac
		fi
	fi
	if [[ $lang == ru ]] && ! locale_is_utf8; then
		raw_warn "Russian needs a UTF-8 terminal; installing with English."
		lang=en
	fi
	CFG[lang]=$lang
	i18n_load "$lang"
}

cmd_install() {
	local want="" iface="" pmode="" ports="" yes=0 force=0 nodpi=0 inter=0 def
	while (($#)); do
		case $1 in
			--backend) want=${2:-}; (($# >= 2)) || die err_usage install; shift 2 ;;
			--iface) iface=${2:-}; (($# >= 2)) || die err_usage install; shift 2 ;;
			--ports-mode) pmode=${2:-}; (($# >= 2)) || die err_usage install; shift 2 ;;
			--ports) ports=${2:-}; (($# >= 2)) || die err_usage install; shift 2 ;;
			--yes | -y) yes=1; shift ;;
			--force) force=1; shift ;;
			--no-dpi) nodpi=1; shift ;;
			*) die err_unknown_opt "$1" ;;
		esac
	done
	need_root; take_lock
	cfg_load || true
	((yes == 0)) && [[ -t 0 && -t 1 ]] && inter=1
	install_choose_lang "$inter"

	# argument validation happens before anything is touched
	[[ -z $want ]] || cfg_valid backend "$want" || die err_cfg_invalid backend "$want"
	[[ -z $pmode ]] || cfg_valid ports_mode "$pmode" || die err_cfg_invalid ports_mode "$pmode"
	[[ -z $ports ]] || ports_valid "$ports" || die err_cfg_invalid ports "$ports"
	[[ -z $iface ]] || cfg_valid iface "$iface" || die err_cfg_invalid iface "$iface"
	if [[ $pmode == only || $pmode == except ]] && [[ -z $ports ]]; then die err_ports_required; fi

	# 1. platform
	os_info
	if [[ $OS_FAMILY == unknown ]] && ((force == 0)); then die err_os_unsupported "${OS_ID:-?}" "$BASE_TOOLS"; fi
	if ! have_systemd && ((force == 0)); then die err_no_systemd; fi
	local missing
	missing=$(base_tools_missing)
	[[ -z $missing ]] || die err_tools_missing "$missing"

	# 2. plan, then packages (nothing on the system has changed up to here)
	plan_install "$want"
	if [[ -n $PLAN_PKGS ]]; then
		say inst_plan_pkgs "$PLAN_BACKEND" "$PLAN_PKGS"
		[[ $OS_FAMILY != unknown ]] || die err_os_unsupported "${OS_ID:-?}" "$PLAN_PKGS"
		say inst_pkg_installing "$PLAN_PKGS"
		# shellcheck disable=SC2086
		pkg_install "$OS_FAMILY" $PLAN_PKGS || die err_pkg_install
		missing=$(backend_missing "$PLAN_BACKEND" | tr '\n' ' ')
		[[ -z ${missing// /} ]] || die err_pkg_still_missing "$missing"
	else
		say inst_plan_none "$PLAN_BACKEND"
	fi

	# 3. wizard / flags
	def=$iface
	if [[ -z $def ]]; then
		def=${CFG[iface]}
		[[ -n $def ]] || def=$(ip route show default 2>/dev/null | awk '{ for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit } }')
	fi
	if ((inter)); then
		[[ -n $iface ]] || iface=$(ask "$(t inst_prompt_iface "$def") " "$def")
		[[ -n $pmode ]] || pmode=$(ask "$(t inst_prompt_mode "${CFG[ports_mode]}") " "${CFG[ports_mode]}")
		if [[ $pmode != all && -z $ports ]]; then ports=$(ask "$(t inst_prompt_ports "${CFG[ports]}") " "${CFG[ports]}"); fi
	else
		[[ -n $iface ]] || iface=$def
	fi
	[[ -n $pmode ]] || pmode=${CFG[ports_mode]}
	[[ $pmode == all || -n $ports ]] || ports=${CFG[ports]}
	cfg_valid iface "$iface" || die err_cfg_invalid iface "$iface"
	cfg_valid ports_mode "$pmode" || die err_cfg_invalid ports_mode "$pmode"
	if [[ $pmode != all ]]; then ports_valid "$ports" || die err_cfg_invalid ports "$ports"; else ports=""; fi

	# 4. backup, configuration, allowlist, sets and rules (monitor mode)
	local bdir
	bdir=$(install_backup)
	say inst_backup "$bdir"
	CFG[backend]=$PLAN_BACKEND
	CFG[iface]=$iface CFG[ports_mode]=$pmode CFG[ports]=$ports
	CFG[mode]=monitor
	((nodpi)) && CFG[dpi]=no
	if [[ -s /proc/net/if_inet6 ]]; then CFG[ipv6]=yes; else CFG[ipv6]=no; fi
	[[ -n ${BB_FORCE_IPV6:-} && ${BB_TESTING:-} == 1 ]] && CFG[ipv6]=$BB_FORCE_IPV6
	mkdir -p -- "$LISTS_D" "$STATE_DIR" "$BACKUP_DIR" || die err_mkdir "$CONF_DIR"
	cfg_save
	[[ -e $MANUAL_FILE ]] || : >"$MANUAL_FILE"
	[[ -e $ALLOW_FILE ]] || : >"$ALLOW_FILE"
	local added
	added=$(allow_autofill | tr '\n' ' ')
	[[ -z $added ]] || say inst_allow_added "${added% }"
	fw_select
	dht_update || true # best effort: DNS may not work yet
	if ! do_apply; then
		err err_install_failed
		say inst_backup_kept "$bdir"
		exit 1
	fi
	((nodpi)) || say inst_dpi_later

	# 5. units
	if have_systemd; then
		units_install || { err err_units; say inst_backup_kept "$bdir"; exit 1; }
		say inst_units
	else
		warn inst_units_skipped
	fi

	# 6. verification
	local problems
	problems=$(selfcheck | awk 'NF')
	if [[ -n $problems ]]; then
		err err_check_failed
		printf '%s\n' "$problems" | sed 's/^/  - /'
		say inst_backup_kept "$bdir"
		exit 1
	fi
	[[ -s $DHT_CACHE ]] || warn warn_check_dht_empty
	rm -rf -- "$BACKUP_DIR"/install-*
	log_event "install backend=$PLAN_BACKEND mode=monitor"
	say inst_check_ok
	# Start the oneshot units only now, with our lock released (they run bb themselves).
	exec 9>&-
	if have_systemd; then
		systemctl start bb-firewall.service bb-update.timer bb-guard.timer >/dev/null 2>&1 || warn warn_units_start
	fi
	say inst_done
}

# Remove every line that mentions bb objects from a saved-rules file.
strip_saved_file() {
	local f=$1 tmp
	[[ -f $f && -r $f ]] || return 0
	grep -qE 'BB_FILTER|(^| )bb_[a-z]' "$f" || return 0
	tmp=$f.bb-new
	awk '/BB_FILTER/ { next } $2 ~ /^bb_/ { next } { print }' "$f" >"$tmp" || { rm -f -- "$tmp"; return 1; }
	chmod --reference="$f" "$tmp" 2>/dev/null
	chown --reference="$f" "$tmp" 2>/dev/null
	mv -f -- "$tmp" "$f" || return 1
	say uninst_resaved "$f"
}

safe_rm_dir() { [[ -n $1 && $1 != / && $1 == /?* ]] && rm -rf -- "$1"; }

cmd_uninstall() {
	local yes=0 purge=0 u ans=""
	while (($#)); do
		case $1 in
			--yes | -y) yes=1; shift ;;
			--purge) purge=1; shift ;;
			*) die err_unknown_opt "$1" ;;
		esac
	done
	need_root; take_lock; cfg_load || true
	if ((yes == 0)); then
		[[ -t 0 && -t 1 ]] || die err_need_yes
		printf '%s ' "$(t uninst_confirm)"
		read -r ans
		[[ ${ans,,} == y || ${ans,,} == yes ]] || { say uninst_aborted; exit 1; }
	fi
	NOTIFY_SYNC=1 log_event "uninstall purge=$purge"
	for u in bb-mode-rollback.timer bb-guard.timer bb-update.timer bb-digest.timer bb-digest.service bb-firewall.service bb-sets.service bb-guard.service bb-update.service; do
		systemctl stop "$u" >/dev/null 2>&1
		systemctl disable "$u" >/dev/null 2>&1
	done
	for u in $UNIT_NAMES; do rm -f -- "$UNIT_DIR/$u" "$UNIT_DIR/$u.new"; done
	systemctl daemon-reload >/dev/null 2>&1
	# Only bb objects go; everything else in the firewall stays as it was.
	have iptables && ipt_remove
	have nft && nft_remove
	for u in $SAVED_RULE_FILES; do strip_saved_file "$u"; done
	rm -f -- "$PENDING_FILE"
	if ((purge)); then
		safe_rm_dir "$CONF_DIR"; safe_rm_dir "$STATE_DIR"; safe_rm_dir "$BACKUP_DIR"
		TMPD=""
		if [[ ${BB_TESTING:-} != 1 ]]; then safe_rm_dir "$SHARE_DIR"; rm -f -- "$BIN_PATH"; fi
		say uninst_purged
	else
		say uninst_done "$CONF_DIR"
	fi
}

cmd___sets_restore() { # boot-time: sets only, before any other firewall service
	need_root; take_lock; load_config require
	fw_tools_ok || exit 1
	mk_tmpdir
	fw_init && sets_load_all
}

cmd___unit() { # print a unit file (debugging and tests)
	cfg_load || true
	unit_text "${1:-}" || die err_usage __unit
}

usage() {
	local topic=${1:-main}
	if [[ -v MSG[help_$topic] ]]; then say "help_$topic"; else say help_main; fi
}

main() {
	local args=() a
	while (($#)); do
		case $1 in
			--lang) ARG_LANG=${2:-}; (($# >= 2)) && shift; shift ;;
			--lang=*) ARG_LANG=${1#*=}; shift ;;
			*) args+=("$1"); shift ;;
		esac
	done
	set -- "${args[@]+"${args[@]}"}"
	i18n_load en
	cfg_load || true
	if [[ -n $ARG_LANG && $ARG_LANG != en && $ARG_LANG != ru ]]; then die err_lang_invalid "$ARG_LANG"; fi
	local lang
	lang=$(effective_lang)
	if [[ $lang == ru ]] && ! locale_is_utf8; then
		raw_warn "Russian needs a UTF-8 terminal; using English for this run."
		lang=en
	fi
	i18n_load "$lang"
	local cmd=${1:-help}
	[[ $# -gt 0 ]] && shift
	for a in "$@"; do
		if [[ $a == --help || $a == -h ]]; then usage "$cmd"; exit 0; fi
	done
	case $cmd in
		help | --help | -h) usage main ;;
		version | --version) say version "$BB_VERSION" ;;
		apply) cmd_apply "$@" ;;
		guard) cmd_guard "$@" ;;
		ban) cmd_ban "$@" ;;
		unban) cmd_unban "$@" ;;
		allow) cmd_allow "$@" ;;
		mode) cmd_mode "$@" ;;
		lang) cmd_lang "$@" ;;
		status) cmd_status "$@" ;;
		list) cmd_list "$@" ;;
		__init-config) cmd___init_config "$@" ;;
		__flow-add) cmd___flow_add "$@" ;;
		__remove) cmd___remove "$@" ;;
		__sets-restore) cmd___sets_restore "$@" ;;
		__unit) cmd___unit "$@" ;;
		notify) cmd_notify "$@" ;;
		__notify-flush) cmd___notify_flush "$@" ;;
		__notify-event) cmd___notify_event "$@" ;;
		__digest) cmd___digest "$@" ;;
		install) cmd_install "$@" ;;
		uninstall) cmd_uninstall "$@" ;;
		*) err err_unknown_cmd "$cmd"; usage main >&2; exit 1 ;;
	esac
}

main "$@"
