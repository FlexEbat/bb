OS_FAMILY="" OS_ID=""
PLAN_BACKEND="" PLAN_PKGS=""
UNIT_NAMES="bb-sets.service bb-firewall.service bb-update.service bb-update.timer bb-guard.service bb-guard.timer bb-digest.service bb-digest.timer bb-notify-failure@.service bb-listener.socket bb-listener@.service bb-ndpid@.service bb-ndpid.service"

os_info() { # sets OS_FAMILY (apt|dnf|unknown) and OS_ID
	local line id="" like="" tok
	OS_FAMILY=unknown OS_ID=""
	[[ -r $OS_RELEASE ]] || return 0
	while IFS= read -r line; do
		case $line in
			ID=*) id=${line#ID=} ;;
			ID_LIKE=*) like=${line#ID_LIKE=} ;;
		esac
	done <"$OS_RELEASE"
	id=${id//\"/} like=${like//\"/}
	OS_ID=$id
	for tok in $id $like; do
		case $tok in
			debian | ubuntu) OS_FAMILY=apt; return 0 ;;
			rhel | fedora | centos | rocky | almalinux | ol) OS_FAMILY=dnf; return 0 ;;
		esac
	done
}

have_systemd() { [[ ${BB_TESTING:-} == 1 ]] || [[ -d /run/systemd/system ]]; }

BASE_TOOLS="flock getent awk sed grep sort timeout logger"
base_tools_missing() {
	local c out=""
	for c in $BASE_TOOLS; do have "$c" || out+=" $c"; done
	printf '%s' "${out# }"
}

pkg_real() { # logical-name family -> distribution package name
	case $1:$2 in
		iproute2:dnf) printf 'iproute\n' ;;
		iptables:dnf) printf 'iptables-nft\n' ;;
		*) printf '%s\n' "$1" ;;
	esac
}

backend_missing() { # backend -> logical packages that are not there yet
	case $1 in
		iptables) have iptables || printf 'iptables\n'; have ipset || printf 'ipset\n' ;;
		nft) have nft || printf 'nftables\n' ;;
	esac
}

# PLAN_BACKEND / PLAN_PKGS: what install is going to use and add.
plan_install() { # [forced backend]
	local want=${1:-} pkgs
	if [[ -n $want ]]; then
		PLAN_BACKEND=$want
		pkgs=$(backend_missing "$want" | tr '\n' ' ')
	else
		detect_backend
		PLAN_BACKEND=$DETECT_BACKEND
		pkgs=$DETECT_PKGS
	fi
	have curl || have wget || pkgs+=" curl"
	have ip || pkgs+=" iproute2"
	PLAN_PKGS=$(printf '%s\n' $pkgs | awk 'NF && !seen[$0]++' | tr '\n' ' ')
	PLAN_PKGS=${PLAN_PKGS% }
}

# What bb itself added to the system is recorded, so that "bb uninstall" can take back
# exactly that and nothing else. Lines: "<kind> <value>" with kind pkg|user.
manifest_add() { # kind value
	[[ $2 =~ ^[A-Za-z0-9_.:+-]+$ ]] || return 1
	mkdir -p -- "$STATE_DIR"
	grep -qxF -- "$1 $2" "$MANIFEST" 2>/dev/null || printf '%s %s\n' "$1" "$2" >>"$MANIFEST"
}

pkgs_snapshot() { # installed package names, sorted
	case $OS_FAMILY in
		apt) dpkg-query -W -f='${Package}\n' 2>/dev/null ;;
		dnf) rpm -qa --qf '%{NAME}\n' 2>/dev/null ;;
	esac | sort -u
}

# Records the packages that appeared between two snapshots (dependencies included).
pkgs_record_new() { # before-snapshot
	local p
	while IFS= read -r p; do manifest_add pkg "$OS_FAMILY:$p"; done < <(comm -13 <(printf '%s\n' "$1") <(pkgs_snapshot))
	return 0
}

pkg_install() { # family logical...
	local fam=$1 p
	local -a real=()
	shift
	for p in "$@"; do real+=("$(pkg_real "$p" "$fam")"); done
	case $fam in
		apt) DEBIAN_FRONTEND=noninteractive apt-get install -y "${real[@]}" ;;
		dnf) dnf install -y "${real[@]}" ;;
		*) return 1 ;;
	esac
}

# ---- allowlist auto-fill: gateway, DNS servers, the current SSH client ----------
allow_autofill() { # prints the entries it added
	local -a cand=()
	local ip f line canon fam
	if have ip; then
		while read -r ip; do cand+=("$ip"); done < <(
			{ ip -4 route show default; ip -6 route show default; } 2>/dev/null |
				awk '{ for (i = 1; i < NF; i++) if ($i == "via") print $(i + 1) }')
	fi
	for f in $RESOLV_FILES; do
		[[ -r $f ]] || continue
		while read -r ip; do cand+=("$ip"); done < <(awk '$1 == "nameserver" { print $2 }' "$f")
	done
	line=${SSH_CONNECTION:-${SSH_CLIENT:-}}
	[[ -n $line ]] && cand+=("${line%% *}")
	for ip in "${cand[@]+"${cand[@]}"}"; do
		ip=${ip%%%*} # drop an IPv6 zone ("fe80::1%eth0")
		[[ $ip =~ ^127\. || $ip == ::1 ]] && continue
		canon=$(norm_entry "$ip") || continue
		fam=${canon%%$'\t'*} canon=${canon#*$'\t'}
		[[ $fam == 6 ]] && ! ipv6_on && continue
		file_family "$ALLOW_FILE" "$fam" | grep -qxF -- "$canon" && continue
		entry_file_put "$ALLOW_FILE" "$canon" "" && printf '%s\n' "$canon"
	done
}

# ---- backups ---------------------------------------------------------------------
install_backup() { # prints the directory
	local d f
	d=$BACKUP_DIR/install-$(date +%Y%m%d-%H%M%S)
	mkdir -p -- "$d"
	[[ -d $CONF_DIR ]] && cp -a -- "$CONF_DIR" "$d/etc-bb" 2>/dev/null
	for f in "$UNIT_DIR"/bb-*.service "$UNIT_DIR"/bb-*.timer; do [[ -e $f ]] && cp -a -- "$f" "$d/" 2>/dev/null; done
	have iptables-save && iptables-save >"$d/iptables.save" 2>/dev/null
	have ip6tables-save && ip6tables-save >"$d/ip6tables.save" 2>/dev/null
	have ipset && ipset save >"$d/ipset.save" 2>/dev/null
	have nft && nft list ruleset >"$d/nft.ruleset" 2>/dev/null
	for f in $SAVED_RULE_FILES; do [[ -r $f ]] && cp -a -- "$f" "$d/saved-$(basename -- "$f")" 2>/dev/null; done
	printf '%s\n' "$d"
}

