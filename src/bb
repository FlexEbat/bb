RemainAfterExit=yes
ExecStart=$bin __sets-restore
$HARDEN

[Install]
WantedBy=sysinit.target
EOF
			;;
		bb-firewall.service)
			cat <<EOF
[Unit]
Description=bb: apply blocking rules
