ARG_LANG=""

need_root() { [[ $EUID -eq 0 ]] || die err_need_root; }

# take_lock [soft]: with "soft" a busy lock returns 1 instead of ending the command.
take_lock() {
	have flock || die err_tools_missing flock
	mkdir -p -- "$(dirname -- "$LOCK_FILE")"
	exec 9>"$LOCK_FILE" || die err_write "$LOCK_FILE"
	local wait=30
	[[ ${BB_TESTING:-} == 1 ]] && wait=${BB_LOCK_WAIT:-30}
	if ! flock -w "$wait" 9; then
		[[ ${1:-} == soft ]] && return 1
		die err_lock
	fi
}

# Load configuration; $1=require -> must be configured (a backend chosen).
load_config() {
	cfg_load || true
	if [[ ${1:-} == require ]]; then
		[[ -n ${CFG[backend]} ]] || die err_not_configured
		fw_select
	elif [[ -n ${CFG[backend]} ]]; then
		fw_select
	fi
}

fw_live() { [[ -n $FW ]] && fw_check >/dev/null 2>&1; }

# D-006: a block mode that was never confirmed must not survive a reboot (the rollback
# timer is transient). Called before apply/guard.
mode_check_pending() {
	[[ -e $PENDING_FILE ]] || return 0
	if systemctl is-active --quiet bb-mode-rollback.timer 2>/dev/null; then return 0; fi
	rm -f -- "$PENDING_FILE"
	[[ ${CFG[mode]} == block ]] || return 0
	CFG[mode]=monitor
	cfg_save
	warn warn_mode_reverted
	log_event "mode_changed mode=monitor reason=unconfirmed"
}

# Rebuild everything from configuration; leaves the old state on failure.
do_apply() {
	local bdir=$BACKUP_DIR/last-apply
	fw_tools_ok || return 1
	((IPV6_UNUSABLE)) && warn warn_ipv6_unusable
	mk_tmpdir
	rm -rf -- "$bdir"
	mkdir -p -- "$bdir"
	fw_backup "$bdir"
	fw_init || return 1
	[[ ${CFG[dpi]} == yes ]] && listener_conf_write
	if ! sets_load_all; then fw_rollback "$bdir"; return 1; fi
	if ! fw_apply; then
		err err_apply_failed
		fw_rollback "$bdir"
		return 1
	fi
	log_event "apply backend=${CFG[backend]} mode=${CFG[mode]}"
	return 0
}

cmd_apply() {
	need_root; take_lock; load_config require
	mode_check_pending
	do_apply || exit 1
	say apply_done "${CFG[backend]}" "${CFG[mode]}"
}

# Guard: used by bb-guard.timer. Quiet when everything is in place.
cmd_guard() {
	need_root
	# A busy lock is not a failure of the guard: it simply runs again at the next interval.
	take_lock soft || { log_event "guard_skipped reason=lock"; exit 0; }
	load_config require
	fw_tools_ok || exit 1
	mode_check_pending
	if ! fw_check; then
		log_event "guard_restored backend=${CFG[backend]}"
		do_apply || exit 1
		say guard_restored
	fi
	notify_allow_refresh
	integrations_refresh
	listener_events_flush
	notify_kick # retries queued messages and sends the "suppressed" summary
	return 0
}

# Hidden helper (used by the installer and the tests): write a default bb.conf.
cmd___init_config() {
	need_root; take_lock
	cfg_load || true
	local backend=""
	local v6=""
	while (($#)); do
		case $1 in
			--backend) backend=${2:-}; shift 2 ;;
			--ipv6) v6=${2:-}; shift 2 ;;
			*) die err_unknown_opt "$1" ;;
		esac
	done
	if [[ -z $backend ]]; then detect_backend; backend=$DETECT_BACKEND; fi
	cfg_valid backend "$backend" || die err_cfg_invalid backend "$backend"
	CFG[backend]=$backend
	if [[ -n $v6 ]]; then cfg_valid ipv6 "$v6" || die err_cfg_invalid ipv6 "$v6"; CFG[ipv6]=$v6
	elif [[ -s /proc/net/if_inet6 ]]; then CFG[ipv6]=yes; else CFG[ipv6]=no; fi
	cfg_save
	mkdir -p -- "$LISTS_D" "$STATE_DIR" "$BACKUP_DIR"
	[[ -e $ALLOW_FILE ]] || : >"$ALLOW_FILE"
	[[ -e $MANUAL_FILE ]] || : >"$MANUAL_FILE"
	say config_written "$backend"
}

# entry-file editing shared by ban/allow
entry_file_put() { # file entry expiry|""
	local file=$1 e=$2 x=${3:-}
	{
		[[ -r $file ]] && awk -v e="$e" '$1 != e' "$file"
		if [[ -n $x ]]; then printf '%s %s\n' "$e" "$x"; else printf '%s\n' "$e"; fi
	} | write_atomic "$file"
}

entry_file_del() { # file entry -> 0 if it was present
	local file=$1 e=$2
	[[ -r $file ]] && awk -v e="$e" '$1 == e { f = 1 } END { exit !f }' "$file" || return 1
	awk -v e="$e" '$1 != e' "$file" | write_atomic "$file"
}

cmd_ban() {
	local entry="" ttl="" sec="" exp=0 line fam canon
	while (($#)); do
		case $1 in
			--ttl) (($# >= 2)) || die err_usage ban; ttl=$2; shift 2 ;;
			-*) die err_unknown_opt "$1" ;;
			*) [[ -z $entry ]] || die err_usage ban; entry=$1; shift ;;
		esac
	done
	[[ -n $entry ]] || die err_usage ban
	need_root; take_lock; load_config
	line=$(norm_entry "$entry") || die err_bad_entry "$entry"
	fam=${line%%$'\t'*} canon=${line#*$'\t'}
	if [[ -n $ttl ]]; then
		sec=$(dur2sec "$ttl") || die err_bad_ttl "$ttl"
		exp=$(($(date +%s) + sec))
	fi
	file_family "$ALLOW_FILE" "$fam" | grep -qxF -- "$canon" && warn warn_ban_allowed "$canon"
	entry_file_put "$MANUAL_FILE" "$canon" "$exp" || die err_write "$MANUAL_FILE"
	if [[ $fam == 6 ]] && ! ipv6_on; then
		: # IPv6 handling is off; the entry is kept in the file only
	elif fw_live; then
		set_add manual "$fam" "$canon" "$sec" || warn warn_set_op "$canon"
	else
		say note_not_applied
	fi
	log_event "manual_change op=ban entry=$canon"
	say ban_done "$canon"
}

cmd_unban() {
	[[ $# -eq 1 && $1 != -* ]] || die err_usage unban
	need_root; take_lock; load_config
	local line fam canon
	line=$(norm_entry "$1") || die err_bad_entry "$1"
	fam=${line%%$'\t'*} canon=${line#*$'\t'}
	entry_file_del "$MANUAL_FILE" "$canon" || die err_not_banned "$canon"
	fw_live && { set_del manual "$fam" "$canon" || true; }
	log_event "manual_change op=unban entry=$canon"
	say unban_done "$canon"
}

cmd_allow() {
	local entry="" rm=0 line fam canon
	while (($#)); do
		case $1 in
			--rm) rm=1; shift ;;
			-*) die err_unknown_opt "$1" ;;
			*) [[ -z $entry ]] || die err_usage allow; entry=$1; shift ;;
		esac
	done
	[[ -n $entry ]] || die err_usage allow
	need_root; take_lock; load_config
	line=$(norm_entry "$entry") || die err_bad_entry "$entry"
	fam=${line%%$'\t'*} canon=${line#*$'\t'}
	if ((rm)); then
		entry_file_del "$ALLOW_FILE" "$canon" || die err_not_allowed "$canon"
		fw_live && { set_del allow "$fam" "$canon" || true; }
		log_event "manual_change op=unallow entry=$canon"
		say allow_removed "$canon"
		return 0
	fi
	entry_file_put "$ALLOW_FILE" "$canon" "" || die err_write "$ALLOW_FILE"
	if fw_live; then
		set_add allow "$fam" "$canon" "" || warn warn_set_op "$canon"
	else
		say note_not_applied
	fi
	log_event "manual_change op=allow entry=$canon"
	say allow_done "$canon"
}

cmd_mode() {
	local want="" confirm="" rollback=0
	while (($#)); do
		case $1 in
			--confirm)
				if [[ ${2:-} =~ ^[0-9]+$ ]]; then confirm=$2; shift 2; else confirm=-1; shift; fi ;;
			--rollback) rollback=1; shift ;;
			-*) die err_unknown_opt "$1" ;;
			*) [[ -z $want ]] || die err_usage mode; want=$1; shift ;;
		esac
	done
	need_root; take_lock; load_config require
	case $want in
		monitor | block) ;;
		confirm)
			rm -f -- "$PENDING_FILE"
			if systemctl stop bb-mode-rollback.timer >/dev/null 2>&1; then say mode_confirmed; else say mode_nothing_pending; fi
			return 0 ;;
		'') say mode_current "${CFG[mode]}"; return 0 ;;
		*) die err_usage mode ;;
	esac
	if [[ $confirm == -1 ]]; then confirm=${CFG[confirm_timeout]}; fi
	[[ $want == block && -n $confirm ]] || confirm=""
	if [[ -n $confirm ]]; then
		have systemd-run || die err_no_systemd_run
		# Arm the rollback first: if the session dies, the timer still fires.
		systemctl stop bb-mode-rollback.timer >/dev/null 2>&1
		systemd-run --quiet --collect --unit=bb-mode-rollback --on-active="${confirm}s" \
			"$SELF" mode monitor --rollback >/dev/null 2>&1 || die err_rollback_arm
		mkdir -p -- "$STATE_DIR"
		date +%s | write_atomic "$PENDING_FILE"
	elif [[ $want == monitor ]]; then
		systemctl stop bb-mode-rollback.timer >/dev/null 2>&1
		rm -f -- "$PENDING_FILE"
	fi
	local old=${CFG[mode]}
	CFG[mode]=$want
	if ! do_apply; then
		CFG[mode]=$old
		[[ -n $confirm ]] && { systemctl stop bb-mode-rollback.timer >/dev/null 2>&1; rm -f -- "$PENDING_FILE"; }
		exit 1
	fi
	cfg_save
	if ((rollback)); then
		log_event "mode_changed mode=$want reason=rollback"
		say mode_rolled_back
		return 0
	fi
	log_event "mode_changed mode=$want"
	say mode_changed "$want"
	if [[ -n $confirm ]]; then
		say mode_confirm_hint "$confirm"
		if [[ -t 0 && -t 1 ]]; then
			local ans=""
			flock -u 9 # waiting for the person must not block guard and the other commands
			printf '%s ' "$(t mode_confirm_prompt)"
			read -r -t "$confirm" ans
			take_lock; load_config require # the state may have changed while the person was thinking
			if [[ ${ans,,} == y || ${ans,,} == yes ]]; then
				systemctl stop bb-mode-rollback.timer >/dev/null 2>&1
				rm -f -- "$PENDING_FILE"
				say mode_confirmed
			else
				printf '\n'
				CFG[mode]=monitor
				systemctl stop bb-mode-rollback.timer >/dev/null 2>&1
				rm -f -- "$PENDING_FILE"
				do_apply && cfg_save
				say mode_rolled_back
			fi
		fi
	fi
}

cmd_lang() {
	local want=${1:-}
	cfg_load || true
	if [[ -z $want ]]; then say lang_current "${CFG[lang]}"; return 0; fi
	[[ $want == en || $want == ru ]] || die err_lang_invalid "$want"
	need_root; take_lock
	cfg_set lang "$want"
	i18n_load "$want"
	say lang_set "$want"
}

json_need() { # --json is built with jq: without it print a hint and stop
	have jq || die err_json_jq
}

# Parses the arguments of a command that takes only --json; sets JSON=1 for it.
json_args() { # cmd args...
	local cmd=$1 a
	shift
	JSON=0
	for a in "$@"; do
		case $a in
			--json) JSON=1 ;;
			*) die err_usage "$cmd" ;;
		esac
	done
	if ((JSON)); then json_need; fi
	return 0
}

# Untranslated status document: stable keys, values straight from the configuration and the kernel.
status_json() { # state(present|absent) variant sets counters
	jq -n --arg version "$BB_VERSION" --arg backend "${CFG[backend]}" --arg variant "$2" \
		--arg mode "${CFG[mode]}" --arg lang "${CFG[lang]}" --arg state "$1" \
		--arg sets "$3" --arg counters "$4" '
		def lines($s): $s | split("\n") | map(select(length > 0) | split(" "));
		def num: try tonumber catch null;
		{version: $version, backend: $backend,
		 iptables_variant: (if $variant == "" then null else $variant end),
		 mode: $mode, lang: $lang,
		 rules: (if $state == "present" then "active" else "inactive" end),
		 sets: [lines($sets)[] | select(length == 2) | {name: .[0], entries: (.[1] | num)}],
		 counters: [lines($counters)[] | select(length == 3) | {category: .[0], packets: (.[1] | num), bytes: (.[2] | num)}]}'
}

cmd_status() {
	json_args status "$@"
	need_root; load_config require
	local state="absent" l
	fw_live && state=present
	if ((JSON)); then
		local variant="" sets="" counters="" kind a b c
		[[ $FW == ipt ]] && variant=$(iptables_variant)
		if [[ $state == present ]]; then
			local out
			out=$(fw_status)
			while read -r kind a b c; do
				case $kind in
					set) sets+="$a $b"$'\n' ;;
					counter) counters+="$a $b $c"$'\n' ;;
				esac
			done < <(sort <<<"$out")
		fi
		status_json "$state" "$variant" "$sets" "$counters"
		return 0
	fi
	say status_title "$BB_VERSION"
	if [[ $FW == ipt ]]; then say status_backend "iptables ($(iptables_variant))"; else say status_backend nft; fi
	say status_mode "${CFG[mode]}"
	say status_lang "${CFG[lang]}"
	say "status_rules_$state"
	[[ $state == present ]] || return 0
	say status_sets
	local out kind a b c
	out=$(fw_status)
	while read -r kind a b c; do
		[[ $kind == set ]] && say status_set_line "$a" "$b"
	done <<<"$out"
	say status_counters
	while read -r kind a b c; do
		[[ $kind == counter ]] && say status_counter_line "$a" "$b" "$c"
	done < <(sort <<<"$out")
	return 0
}

cmd_list() {
	local sub=${1:-show}
	[[ $# -gt 0 ]] && shift
	case $sub in
		show)
			load_config
			local f n any=0
			for f in "$LISTS_D"/*.conf; do
				[[ -e $f ]] || continue
				n=$(basename -- "$f" .conf)
				list_read "$n" || continue
				say list_line "$n" "$L_TYPE" "$(list_meta_get "$n" count)" "$L_SOURCE"
				any=1
			done
			[[ -r $DHT_CACHE ]] && { say list_line_dht "$(wc -l <"$DHT_CACHE")"; any=1; }
			((any)) || say list_none ;;
		add)
			local name=${1:-} src=${2:-} sha="" ltype
			[[ $# -ge 2 ]] || die err_usage list
			shift 2
			while (($#)); do
				case $1 in
					--sha256) (($# >= 2)) || die err_usage list; sha=$2; shift 2 ;;
					*) die err_unknown_opt "$1" ;;
				esac
			done
			list_name_valid "$name" || die err_bad_listname "$name"
			[[ -z $sha || $sha =~ ^[0-9A-Fa-f]{64}$ ]] || die err_bad_sha
			[[ $src =~ ^[^[:space:]\']+$ ]] || die err_bad_source
			need_root; take_lock; load_config
			case $src in
				https://*) ltype=url ;;
				http://* | ftp://* | *://*) die err_https_only ;;
				*)
					src=$(readlink -f -- "$src") || die err_bad_source
					[[ -f $src && -r $src ]] || die err_bad_source
					ltype='file' ;;
			esac
			mkdir -p -- "$LISTS_D"
			printf "type='%s'\nsource='%s'\nsha256='%s'\n" "$ltype" "$src" "$sha" | write_atomic "$LISTS_D/$name.conf"
			say list_added "$name" ;;
		update)
			need_root; load_config
			mk_tmpdir
			local names=() ok=() f n rc worst=0 changed=0 dht=0 dht_ok=0
			if [[ -n ${1:-} ]]; then
				if [[ $1 == dht ]]; then dht=1; else list_name_valid "$1" && [[ -e $LISTS_D/$1.conf ]] || die err_no_list "$1"; names=("$1"); fi
			else
				for f in "$LISTS_D"/*.conf; do [[ -e $f ]] && names+=("$(basename -- "$f" .conf)"); done
				dht=1
			fi
			# phase 1, no lock: everything that waits for the network
			for n in "${names[@]+"${names[@]}"}"; do
				if list_fetch_one "$n"; then ok+=("$n"); else worst=1; fi
			done
			if ((dht)); then
				if dht_build; then dht_ok=1; else worst=1; fi
			fi
			# phase 2, under the lock: safety checks against the stored state, then the sets
			take_lock; load_config
			for n in "${ok[@]+"${ok[@]}"}"; do
				list_commit_one "$n"; rc=$?
				((rc == 0)) && changed=1 || worst=1
			done
			if ((changed)) && [[ -n $FW ]] && fw_live; then sets_refresh list || worst=1; fi
			if ((dht_ok)); then
				dht_commit; rc=$?
				if ((rc == 0)); then [[ -n $FW ]] && fw_live && { sets_refresh dht || worst=1; }; else worst=1; fi
			fi
			notify_allow_refresh
			exit "$worst" ;;
		rm)
			[[ $# -eq 1 ]] || die err_usage list
			list_name_valid "$1" && [[ -e $LISTS_D/$1.conf ]] || die err_no_list "$1"
			need_root; take_lock; load_config
			rm -f -- "$LISTS_D/$1.conf" "$CACHE_DIR/$1.list" "$CACHE_DIR/$1.meta"
			[[ -n $FW ]] && fw_live && sets_refresh list
			say list_removed "$1" ;;
		*) die err_usage list ;;
	esac
}

# Hidden helper: add one dynamic flow (the nDPId listener will use flow_add directly).
cmd___flow_add() { # fam src sport dst dport proto [ttl]
	[[ $# -ge 6 ]] || die err_usage __flow-add
	need_root; take_lock; load_config require
	local fam=$1 sip=$2 sp=$3 dip=$4 dp=$5 proto=$6 ttl=${7:-} l
	[[ $fam == 4 || $fam == 6 ]] || die err_usage __flow-add
	[[ $proto == tcp || $proto == udp ]] || die err_usage __flow-add
	for l in "$sp" "$dp"; do
		[[ $l =~ ^[0-9]{1,5}$ ]] && ((10#$l >= 1 && 10#$l <= 65535)) || die err_usage __flow-add
	done
	for l in "$sip" "$dip"; do
		[[ $l != */* ]] && norm_entry "$l" >/dev/null && [[ $(fam_of "$l") == "$fam" ]] || die err_bad_entry "$l"
	done
	[[ -n $ttl ]] || ttl=$(dur2sec "${CFG[flow_ttl]}")
	flow_add "$fam" "$sip" "$((10#$sp))" "$dip" "$((10#$dp))" "$proto" "$ttl" || die err_set_load flow
}

# Hidden helper: remove every bb object (what 'bb uninstall' will do).
cmd___remove() {
	need_root; take_lock; load_config require
	fw_remove
}

# ---- notifications (tech.md section 9) ---------------------------------------------------
NOTIFY_EVENTS_ALL="mode_changed guard_restored list_update_failed list_rejected service_failed rate_limit integration_changed manual_change digest install uninstall"
declare -A NCFG=()

notify_events_valid() { # comma list of known event ids (may be empty)
	local e
	[[ -z $1 ]] && return 0
	local IFS=,
	for e in $1; do
		[[ " $NOTIFY_EVENTS_ALL " == *" $e "* ]] || return 1
	done
}

ncfg_valid() { # key value
	local k=$1 v=$2
	case $k in
		telegram_token) [[ $v =~ ^[0-9]{5,12}:[A-Za-z0-9_-]{20,64}$ ]] ;;
		telegram_chat) [[ $v =~ ^(-?[0-9]{1,20}|@[A-Za-z0-9_]{4,64})$ ]] ;;
		matrix_url) [[ $v =~ ^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~/-]*)?$ ]] ;;
		matrix_token) [[ $v =~ ^[A-Za-z0-9._~+/=-]{8,512}$ ]] ;;
		matrix_room) [[ $v =~ ^![A-Za-z0-9._=/+-]{1,128}:[A-Za-z0-9.-]{1,253}(:[0-9]{1,5})?$ ]] ;;
		*) return 1 ;;
	esac
}

ncfg_load() {
	NCFG=([telegram_token]='' [telegram_chat]='' [matrix_url]='' [matrix_token]='' [matrix_room]='')
	[[ -r $NOTIFY_CONF ]] || return 1
	local line k v
	while IFS= read -r line || [[ -n $line ]]; do
		if [[ $line =~ ^notify_([a-z_]+)=\'([^\']*)\'$ ]]; then
			k=${BASH_REMATCH[1]} v=${BASH_REMATCH[2]}
			[[ -v NCFG[$k] ]] && ncfg_valid "$k" "$v" && NCFG[$k]=$v
		fi
	done <"$NOTIFY_CONF"
	return 0
}

ncfg_save() { # secrets only; root, 0600, atomic
	local k
	mkdir -p -- "$CONF_DIR" || return 1
	{
		printf '# bb notification secrets - root only, never copy into tickets or chats\n' # bb-lint: ok
		for k in telegram_token telegram_chat matrix_url matrix_token matrix_room; do
			printf "notify_%s='%s'\n" "$k" "${NCFG[$k]}"
		done
	} | write_atomic "$NOTIFY_CONF"
}

# D-003: only the secrets live in notify.conf; the other notify_* settings are in bb.conf
notify_channels() { # prints configured channels, one per line
	[[ -n ${NCFG[telegram_token]} && -n ${NCFG[telegram_chat]} ]] && printf 'telegram\n'
	[[ -n ${NCFG[matrix_url]} && -n ${NCFG[matrix_token]} && -n ${NCFG[matrix_room]} ]] && have jq && printf 'matrix\n'
	return 0
}

notify_host() { { hostname 2>/dev/null || uname -n; } | tr -cd 'A-Za-z0-9._-' | head -c 64; }

# Quote a string for a curl config file ("-K"): the secrets and the message travel on
# stdin, never on the command line.
curl_q() {
	local s=$1
	s=${s//\\/\\\\}
	s=${s//\"/\\\"}
	s=${s//$'\n'/\\n}
	s=${s//$'\t'/\\t}
	s=${s//$'\r'/\\r}
	printf '%s' "$s"
}

notify_curl_common() {
	printf 'silent\nfail\nmax-time = 10\nconnect-timeout = 10\nproto = "=https"\noutput = "/dev/null"\n'
	[[ -n ${CFG[notify_proxy]} ]] && printf 'proxy = "%s"\n' "$(curl_q "${CFG[notify_proxy]}")"
	return 0
}

# Each sender returns curl's exit code. Nothing secret is ever echoed or logged.
send_telegram() { # text
	local text=${1:0:3900}
	{
		printf 'url = "https://api.telegram.org/bot%s/sendMessage"\n' "${NCFG[telegram_token]}"
		printf 'data-urlencode = "chat_id=%s"\n' "$(curl_q "${NCFG[telegram_chat]}")"
		printf 'data-urlencode = "text=%s"\n' "$(curl_q "$text")"
		notify_curl_common
	} | curl -K - >/dev/null 2>&1
}

send_matrix() { # [txn_id] text  (a retried queue entry reuses its transaction id)
	local txn text json room
	if (($# >= 2)); then txn=$1 text=$2; else text=$1 txn="bb$(date +%s%N)$RANDOM"; fi
	have jq || return 127
	json=$(jq -nc --arg body "${text:0:3900}" '{msgtype: "m.text", body: $body}') || return 1
	# jq 1.6 leaves ! * ' ( ) unescaped in @uri and jq 1.7 escapes them: make the result the same
	room=$(jq -rn --arg v "${NCFG[matrix_room]}" '$v | @uri | gsub("!"; "%21") | gsub("\\*"; "%2A") | gsub("'"'"'"; "%27") | gsub("\\("; "%28") | gsub("\\)"; "%29")') || return 1
	{
		printf 'url = "%s/_matrix/client/v3/rooms/%s/send/m.room.message/%s"\n' "${NCFG[matrix_url]%/}" "$room" "$txn"
		printf 'request = "PUT"\n'
		printf 'header = "Authorization: Bearer %s"\n' "${NCFG[matrix_token]}"
		printf 'header = "Content-Type: application/json"\n'
		printf 'data = "%s"\n' "$(curl_q "$json")"
		notify_curl_common
	} | curl -K - >/dev/null 2>&1
}

# ---- message composition (in the notification language) ---------------------------------
kv_get() { # "k=v k=v" key -> sanitized value (untrusted input never reaches a message raw)
	local w
	for w in $1; do
		if [[ $w == "$2="* ]]; then
			w=${w#*=}
			w=${w//[^A-Za-z0-9._@:-]/?}
			printf '%s' "${w:0:64}"
			return 0
		fi
	done
}

notify_lang() { local l=${CFG[notify_lang]:-}; [[ -n $l ]] || l=${CFG[lang]}; printf '%s\n' "$l"; }

# notify_compose event "k=v ..." -> one-line text; digest/test bodies come ready-made.
notify_compose() {
	local ev=$1 rest=$2 body=${3:-} nl host
	nl=$(notify_lang)
	host=$(notify_host)
	(
		i18n_load "$nl"
		local name reason text
		case $ev in
			mode_changed)
				reason=$(kv_get "$rest" reason)
				if [[ -n $reason ]]; then text=$(t ev_mode_reverted "$(kv_get "$rest" mode)")
				else text=$(t ev_mode_changed "$(kv_get "$rest" mode)"); fi ;;
			guard_restored) text=$(t ev_guard_restored) ;;
			list_update_failed) text=$(t ev_list_update_failed "$(kv_get "$rest" name)") ;;
			list_rejected)
				reason=$(kv_get "$rest" reason)
				case $reason in empty | shrunk | size | sha256) reason=$(t "rsn_$reason") ;; *) reason='?' ;; esac
				text=$(t ev_list_rejected "$(kv_get "$rest" name)" "$reason") ;;
			service_failed) text=$(t ev_service_failed "$(kv_get "$rest" unit)") ;;
			rate_limit) text=$(t ev_rate_limit) ;;
			integration_changed) text=$(t ev_integration_changed) ;;
			manual_change)
				name=$(kv_get "$rest" op)
				case $name in ban | unban | allow | unallow) ;; *) name='?' ;; esac # never the address itself
				text=$(t ev_manual_change "$name") ;;
			install) text=$(t ev_install "$(kv_get "$rest" backend)") ;;
			uninstall) text=$(t ev_uninstall) ;;
			test) text=$(t ev_test) ;;
			digest) text=$body ;;
			*) exit 1 ;;
		esac
		if [[ $ev == digest ]]; then
			printf '[%s] %s:\n%s' "$host" "$ev" "$text"
		else
			printf '[%s] %s: %s (%s)' "$host" "$ev" "$text" "$(t msg_footer "${CFG[mode]}" "${CFG[backend]:--}")"
		fi
	)
}

# ---- state: dedup, rate limit, queue ------------------------------------------------------
# All of it lives under $NOTIFY_LOCK, held only for short file edits.
text_key() { printf '%s' "$1" | sha256sum | cut -c1-24; }

queue_len() { [[ -r $NOTIFY_QUEUE ]] && awk 'END { print NR }' "$NOTIFY_QUEUE" || printf '0\n'; }

# notify_enqueue event text [force]: applies dedup + rate limit unless forced.
notify_enqueue() {
	local ev=$1 text=$2 force=${3:-0} now key id b64 cnt dedup limit qmax
	now=$(date +%s)
	dedup=$(dur2sec "${CFG[notify_dedup]}")
	limit=${CFG[notify_rate_limit]}
	qmax=${CFG[notify_queue_max]}
	key=$(text_key "$ev|$text")
	id="$now$RANDOM"
	b64=$(printf '%s' "$text" | base64 -w0)
	mkdir -p -- "$STATE_DIR"
	(
		flock 8
		if ((force == 0)); then
			# dedup: identical events are suppressed for notify_dedup
			if [[ -r $NOTIFY_DEDUP ]]; then
				awk -v n="$now" -v w="$dedup" '$1 > n - w' "$NOTIFY_DEDUP" >"$NOTIFY_DEDUP.new" && mv -f -- "$NOTIFY_DEDUP.new" "$NOTIFY_DEDUP"
				awk -v k="$key" '$2 == k { f = 1 } END { exit !f }' "$NOTIFY_DEDUP" && exit 10
			fi
			printf '%s %s\n' "$now" "$key" >>"$NOTIFY_DEDUP"
			# global limit per hour; the excess is only counted
			if [[ -r $NOTIFY_RATE ]]; then
				awk -v n="$now" '$1 > n - 3600' "$NOTIFY_RATE" >"$NOTIFY_RATE.new" && mv -f -- "$NOTIFY_RATE.new" "$NOTIFY_RATE"
			fi
			cnt=0
			[[ -r $NOTIFY_RATE ]] && cnt=$(awk 'END { print NR }' "$NOTIFY_RATE")
			if ((cnt >= limit)); then
				printf '%s\n' "$(($(cat "$NOTIFY_SUPP" 2>/dev/null || printf 0) + 1))" >"$NOTIFY_SUPP"
				exit 11
			fi
			printf '%s\n' "$now" >>"$NOTIFY_RATE"
		fi
		pending=""
		[[ -n ${NCFG[telegram_token]} && -n ${NCFG[telegram_chat]} ]] && pending=telegram
		if [[ -n ${NCFG[matrix_url]} && -n ${NCFG[matrix_token]} && -n ${NCFG[matrix_room]} ]] && have jq; then pending+=${pending:+,}matrix; fi
		[[ -n $pending ]] || exit 12
		printf '%s\t%s\t%s\t%s\n' "$id" "$now" "$pending" "$b64" >>"$NOTIFY_QUEUE"
		# bounded queue: the oldest messages go first
		if (($(awk 'END { print NR }' "$NOTIFY_QUEUE") > qmax)); then
			tail -n "$qmax" "$NOTIFY_QUEUE" >"$NOTIFY_QUEUE.new" && mv -f -- "$NOTIFY_QUEUE.new" "$NOTIFY_QUEUE"
		fi
		exit 0
	) 8>"$NOTIFY_LOCK"
}

# Deliver what is queued. One flusher at a time; the queue lock is never held during I/O.
notify_flush() {
	have curl || return 0
	mkdir -p -- "$STATE_DIR"
	exec 7>"$NOTIFY_FLUSH_LOCK"
	flock -n 7 || return 0
	ncfg_load || return 0
	local now ttl limit cnt supp id ts pending b64 ch left text rc
	local -a done_ids=() part=()
	now=$(date +%s)
	ttl=$(dur2sec "${CFG[notify_queue_ttl]}")
	limit=${CFG[notify_rate_limit]}

	# the "N notifications suppressed" message goes out once there is room again
	supp=$(cat "$NOTIFY_SUPP" 2>/dev/null || printf 0)
	if ((supp > 0)); then
		cnt=0
		[[ -r $NOTIFY_RATE ]] && cnt=$(awk -v n="$now" '$1 > n - 3600' "$NOTIFY_RATE" | awk 'END { print NR }')
		if ((cnt < limit)); then
			text=$( (i18n_load "$(notify_lang)"; printf '[%s] rate_limit: %s' "$(notify_host)" "$(t msg_suppressed "$supp")") )
			(flock 8; rm -f -- "$NOTIFY_SUPP"; printf '%s\n' "$now" >>"$NOTIFY_RATE") 8>"$NOTIFY_LOCK"
			notify_enqueue summary "$text" 1
		fi
	fi

	[[ -r $NOTIFY_QUEUE ]] || return 0
	local snap
	snap=$(cat "$NOTIFY_QUEUE")
	while IFS=$'\t' read -r id ts pending b64; do
		[[ -n $id ]] || continue
		if ((now - ts > ttl)); then done_ids+=("$id"); continue; fi
		text=$(printf '%s' "$b64" | base64 -d 2>/dev/null) || { done_ids+=("$id"); continue; }
		left=""
		for ch in ${pending//,/ }; do
			rc=1
			case $ch in
				telegram) send_telegram "$text"; rc=$? ;;
				matrix) send_matrix "bb$id" "$text"; rc=$? ;;
			esac
			((rc == 0)) || left+=${left:+,}$ch
		done
		if [[ -z $left ]]; then done_ids+=("$id"); elif [[ $left != "$pending" ]]; then part+=("$id=$left"); fi
	done <<<"$snap"
	((${#done_ids[@]} + ${#part[@]} > 0)) || return 0
	(
		flock 8
		[[ -r $NOTIFY_QUEUE ]] || exit 0
		awk -F'\t' -v OFS='\t' -v done="${done_ids[*]}" -v part="${part[*]}" '
			BEGIN { n = split(done, a, " "); for (i = 1; i <= n; i++) d[a[i]] = 1
			        m = split(part, b, " "); for (i = 1; i <= m; i++) { split(b[i], kv, "="); p[kv[1]] = kv[2] } }
			$1 in d { next }
			$1 in p { $3 = p[$1] }
			{ print }' "$NOTIFY_QUEUE" >"$NOTIFY_QUEUE.new" && mv -f -- "$NOTIFY_QUEUE.new" "$NOTIFY_QUEUE"
	) 8>"$NOTIFY_LOCK"
	return 0
}

# Run the flusher without holding anything of ours: the caller's lock (fd 9) is closed
# in the child so a slow or dead network can never delay a firewall command.
notify_kick() {
	if [[ ${BB_TESTING:-} == 1 && ${BB_NOTIFY_SYNC:-} == 1 ]] || [[ ${NOTIFY_SYNC:-} == 1 ]]; then
		notify_flush
		return 0
	fi
	have curl || return 0
	"$SELF" __notify-flush 9>&- </dev/null >/dev/null 2>&1 &
	disown 2>/dev/null
	return 0
}

notify_hook() { # "event k=v ..." [ready-made body]
	local ev=${1%% *} rest="" text
	[[ $1 == *" "* ]] && rest=${1#* }
	[[ ${CFG[notify_enabled]:-no} == yes ]] || return 0
	[[ ,${CFG[notify_events]}, == *,"$ev",* ]] || return 0
	ncfg_load || return 0
	[[ -n $(notify_channels) ]] || return 0
	text=$(notify_compose "$ev" "$rest" "${2:-}") || return 0
	notify_enqueue "$ev" "$text" 0 || return 0
	notify_kick
}

# ---- keep the notification endpoints reachable ---------------------------------------------
allow_union() { # fam -> manual allowlist plus generated entries
	{ file_family "$ALLOW_FILE" "$1"; file_family "$NOTIFY_ALLOW_FILE" "$1"; file_family "$INTEG_ALLOW" "$1"; } | sort -u
}

allow_reload_live() { # push allow.list + generated entries and the internal networks into the live sets
	local f
	[[ -n $FW ]] && fw_live || return 0
	mk_tmpdir
	for f in $(fw_families); do
		allow_union "$f" >"$TMPD/allow.live.$f"
		set_replace allow "$f" "$TMPD/allow.live.$f" || true
		file_family "$INTEG_INTERNAL" "$f" >"$TMPD/internal.live.$f"
		set_replace internal "$f" "$TMPD/internal.live.$f" || true
	done
}

notify_allow_refresh() { # best effort, needs DNS
	local hosts="" h tmp
	if ! ncfg_load || [[ ${CFG[notify_enabled]} != yes || ${CFG[notify_allow]} != yes ]]; then
		[[ -e $NOTIFY_ALLOW_FILE ]] && { rm -f -- "$NOTIFY_ALLOW_FILE"; allow_reload_live; }
		return 0
	fi
	[[ -n ${NCFG[telegram_token]} ]] && hosts=api.telegram.org
	if [[ -n ${NCFG[matrix_url]} ]]; then
		h=${NCFG[matrix_url]#https://}
		h=${h%%/*}
		hosts+=" ${h%%:*}"
	fi
	mk_tmpdir
	tmp=$TMPD/notify.allow
	: >"$tmp"
	for h in $hosts; do
		timeout 5 getent ahosts "$h" 2>/dev/null | awk '{ print $1 }' | sort -u |
			awk -v strip=0 -v minp4=0 -v minp6=0 -v hosts=0 -f "$AWK_NET" | awk -F'\t' '{ print $2 }' >>"$tmp"
	done
	[[ -s $tmp ]] || return 0 # keep the previous addresses when DNS fails
	sort -u "$tmp" | write_atomic "$NOTIFY_ALLOW_FILE"
	allow_reload_live
}

# ---- daily digest ---------------------------------------------------------------------------
digest_body() { # in the notification language; no addresses, no secrets
	local out kind a b c f n line cur dp="" ev="" evn
	out=$(fw_status 2>/dev/null)
	(
		i18n_load "$(notify_lang)"
		t dg_mode "${CFG[mode]}" "${CFG[backend]}"; printf '\n'
		line=""
		while read -r kind a b c; do [[ $kind == set ]] && line+="$a=$b "; done <<<"$out"
		t dg_sets "${line% }"; printf '\n'
		declare -A prev=()
		if [[ -r $DIGEST_SNAP ]]; then while read -r a b; do prev[$a]=$b; done <"$DIGEST_SNAP"; fi
		while read -r kind a b c; do
			[[ $kind == counter ]] || continue
			cur=$b
			n=$((cur - ${prev[$a]:-0}))
			((n < 0)) && n=$cur # counters restart when the rules are rebuilt
			dp+="$a=$n "
		done < <(sort <<<"$out")
		t dg_packets "${dp% }"; printf '\n'
		line=""
		for f in "$CACHE_DIR"/*.meta; do
			[[ -e $f ]] || continue
			a=$(basename -- "$f" .meta)
			[[ $a =~ ^[a-z0-9][a-z0-9_-]{0,31}$ ]] || continue
			line+="$a=$(list_meta_get "$a" count) "
		done
		[[ -r $DHT_CACHE ]] && line+="dht=$(awk 'END { print NR }' "$DHT_CACHE") "
		t dg_lists "${line:--}"; printf '\n'
		if have journalctl; then
			for evn in guard_restored list_update_failed list_rejected; do
				n=$(journalctl -t bb --since "24 hours ago" -o cat 2>/dev/null | grep -c "^$evn" || true)
				ev+="$evn=${n:-0} "
			done
			t dg_events "${ev% }"
		fi
	)
	# remember the counters for the next digest
	while read -r kind a b c; do [[ $kind == counter ]] && printf '%s %s\n' "$a" "$b"; done <<<"$out" | write_atomic "$DIGEST_SNAP"
}

digest_timer_sync() {
	have_systemd || return 0
	if [[ ${CFG[notify_enabled]} == yes && ,${CFG[notify_events]}, == *,digest,* ]]; then
		systemctl enable --now bb-digest.timer >/dev/null 2>&1
	else
		systemctl disable --now bb-digest.timer >/dev/null 2>&1
	fi
	return 0
}

cmd___digest() {
	need_root; load_config require
	notify_hook "digest" "$(digest_body)"
}

cmd___notify_flush() { need_root; cfg_load || true; notify_flush; }

cmd___notify_event() { # ev [k=v ...]: used by bb-notify-failure@.service
	[[ $# -ge 1 ]] || die err_usage __notify-event
	need_root; load_config
	notify_hook "$*"
}

# ---- CLI: bb notify ----------------------------------------------------------------------------
read_secret() { # prompt-key -> value on stdout (silent on a terminal)
	local v=""
	if [[ -t 0 ]]; then read -r -s -p "$(t "$1") " v; printf '\n' >&2; else read -r v || true; fi
	printf '%s\n' "$v"
}

read_plain() {
	local v=""
	if [[ -t 0 ]]; then read -r -p "$(t "$1") " v; else read -r v || true; fi
	printf '%s\n' "$v"
}

telegram_detect_chat() { # needs jq; the user has written to the bot
	have jq || die err_notify_jq Telegram
	local cfg out
	cfg=$(printf 'url = "https://api.telegram.org/bot%s/getUpdates"\n' "${NCFG[telegram_token]}"; notify_curl_common | grep -v '^output')
	out=$(printf '%s\n' "$cfg" | curl -K - 2>/dev/null) || return 1
	jq -r '[.result[]? | (.message // .channel_post // .my_chat_member // empty) | .chat.id] | last // empty' <<<"$out" 2>/dev/null
}

cmd_notify_setup() {
	local ch=${1:-} v rc
	need_root; take_lock; load_config
	have curl || die err_tools_missing curl
	ncfg_load || true
	case $ch in
		telegram)
			v=$(read_secret notify_setup_token)
			ncfg_valid telegram_token "$v" || die err_notify_bad_value token
			NCFG[telegram_token]=$v
			v=$(read_plain notify_setup_chat)
			if [[ -z $v ]]; then
				say notify_setup_chat_wait
				[[ -t 0 ]] && read -r _
				v=$(telegram_detect_chat) || v=""
				[[ -n $v ]] || die err_notify_chat_detect
			fi
			ncfg_valid telegram_chat "$v" || die err_notify_bad_value chat
			NCFG[telegram_chat]=$v ;;
		matrix)
			have jq || die err_notify_jq Matrix
			v=$(read_plain notify_setup_url); v=${v%/}
			ncfg_valid matrix_url "$v" || die err_notify_bad_value url
			NCFG[matrix_url]=$v
			v=$(read_secret notify_setup_mtoken)
			ncfg_valid matrix_token "$v" || die err_notify_bad_value token
			NCFG[matrix_token]=$v
			v=$(read_plain notify_setup_room)
			ncfg_valid matrix_room "$v" || die err_notify_bad_value room
			NCFG[matrix_room]=$v ;;
		*) die err_usage notify ;;
	esac
	CFG[notify_enabled]=yes # the test below needs the proxy setting, not the flag
	say notify_testing
	if [[ $ch == telegram ]]; then send_telegram "$(notify_compose test "")"; rc=$?; else send_matrix "$(notify_compose test "")"; rc=$?; fi
	if ((rc != 0)); then
		CFG[notify_enabled]=no
		die err_notify_test_failed "$ch" "$rc"
	fi
	ncfg_save || die err_write "$NOTIFY_CONF"
	cfg_save
	notify_allow_refresh
	digest_timer_sync
	say notify_saved "$ch"
}

cmd_notify_test() {
	need_root; load_config
	have curl || die err_tools_missing curl
	ncfg_load || die err_notify_none
	local ch bad=0 rc txt
	[[ -n $(notify_channels) ]] || die err_notify_none
	txt=$(notify_compose test "")
	for ch in $(notify_channels); do
		if [[ $ch == telegram ]]; then send_telegram "$txt"; rc=$?; else send_matrix "$txt"; rc=$?; fi
		if ((rc == 0)); then say notify_test_ok "$ch"; else warn warn_notify_test_failed "$ch" "$rc"; bad=1; fi
	done
	exit "$bad"
}

cmd_notify_status() {
	need_root; load_config
	local st=off ch
	[[ ${CFG[notify_enabled]} == yes ]] && st=on
	ncfg_load || true
	say ns_state "$(t "word_$st")"
	for ch in telegram matrix; do
		if [[ $(notify_channels) == *"$ch"* ]]; then say ns_channel "$ch" "$(t word_configured)"; else say ns_channel "$ch" "$(t word_not_configured)"; fi
	done
	say ns_events "${CFG[notify_events]:--}"
	say ns_queue "$(queue_len)" "$(cat "$NOTIFY_SUPP" 2>/dev/null || printf 0)"
}

cmd_notify() {
	local sub=${1:-status}
	[[ $# -gt 0 ]] && shift
	case $sub in
		setup) cmd_notify_setup "$@" ;;
		test) cmd_notify_test "$@" ;;
		status) cmd_notify_status "$@" ;;
		enable)
			need_root; take_lock; load_config
			ncfg_load || die err_notify_none
			[[ -n $(notify_channels) ]] || die err_notify_none
			cfg_set notify_enabled yes; notify_allow_refresh; digest_timer_sync; say notify_enabled ;;
		disable)
			need_root; take_lock; load_config
			cfg_set notify_enabled no; notify_allow_refresh; digest_timer_sync; say notify_disabled ;;
		events)
			need_root; take_lock; load_config
			if [[ $# -eq 0 ]]; then say ns_events "${CFG[notify_events]:--}"; return 0; fi
			local e
			for e in ${1//,/ }; do [[ " $NOTIFY_EVENTS_ALL " == *" $e "* ]] || die err_notify_event "$e"; done
			cfg_set notify_events "$1"; digest_timer_sync; say ns_events "${CFG[notify_events]:--}" ;;
		*) die err_usage notify ;;
	esac
}

# ---- integrations (tech.md section 8) --------------------------------------------------------
# bb never touches the rules of Docker, k8s, ufw or firewalld. It only learns their networks:
#  - container/pod networks -> set "internal": exempt only when BOTH ends are internal, so
#    pod<->pod passes while a pod talking to a blocked address is still dropped;
#  - node addresses -> regular allowlist (exempt as either endpoint).
norm_nets() { # stdin: free-form networks -> canonical, one per line (private ranges kept)
	awk -v strip=0 -v minp4=$MIN_PREFIX4 -v minp6=$MIN_PREFIX6 -v hosts=0 -f "$AWK_NET" | awk -F'\t' '{ print $2 }'
}

integ_enabled() { # name -> 0 if this integration is switched on by the configuration
	local i=${CFG[integrations]}
	[[ $i == none ]] && return 1
	[[ $i == auto ]] && { [[ $1 == docker || $1 == k8s ]]; return; }
	[[ ,$i, == *,"$1",* ]]
}

docker_present() {
	have docker && return 0
	have ip && ip -o link show 2>/dev/null | awk '{ n = $2; sub(/[:@].*/, "", n); if (n == "docker0" || n ~ /^br-/) f = 1 } END { exit !f }'
}

docker_nets() {
	local ids
	if have ip; then
		ip -o addr show 2>/dev/null | awk '
			{ n = $2; sub(/@.*/, "", n); if (n != "docker0" && n !~ /^br-/) next
			  if ($3 == "inet6" && $4 ~ /^fe80:/) next
			  if ($3 == "inet" || $3 == "inet6") print $4 }'
	fi
	if have docker; then
		ids=$(timeout 5 docker network ls -q 2>/dev/null | tr '\n' ' ')
		# shellcheck disable=SC2086
		[[ -n $ids ]] && timeout 5 docker network inspect $ids --format '{{range .IPAM.Config}}{{.Subnet}} {{end}}' 2>/dev/null | tr ' ' '\n'
	fi
	return 0
}

# YAML-ish "key: value" / "key:\n  - value" reader for the k3s configuration files
yaml_values() { # key files...
	local key=$1
	shift
	[[ $# -gt 0 ]] || return 0
	awk -v key="$key" '
		function emit(v,   n, a, i) { gsub(/["\x27]/, "", v); n = split(v, a, ","); for (i = 1; i <= n; i++) { gsub(/^[ \t]+|[ \t]+$/, "", a[i]); if (a[i] != "") print a[i] } }
		/^[ \t]*#/ { next }
		$0 ~ "^[ \t]*" key ":" { v = $0; sub(/^[^:]*:[ \t]*/, "", v); sub(/[ \t]*#.*/, "", v); inlist = (v == ""); if (!inlist) emit(v); next }
		inlist && /^[ \t]*-[ \t]/ { v = $0; sub(/^[ \t]*-[ \t]*/, "", v); sub(/[ \t]*#.*/, "", v); emit(v); next }
		inlist && NF { inlist = 0 }' "$@" 2>/dev/null
}

k3s_files() { local f; for f in "$K3S_DIR/config.yaml" "$K3S_DIR"/config.yaml.d/*.yaml; do [[ -r $f ]] && printf '%s\n' "$f"; done; }
k3s_present() { [[ -d $K3S_DIR ]] || have k3s; }
kubeadm_present() { [[ -d $KUBE_MANIFEST_DIR ]]; }

k8s_present() {
	k3s_present || kubeadm_present || [[ -n ${CFG[k8s_pod_cidr]}${CFG[k8s_service_cidr]} ]]
}

# kind = pod | service
k8s_nets() {
	local kind=$1 key flag manual found=0 f v
	local -a files=()
	if [[ $kind == pod ]]; then key=cluster-cidr flag=cluster-cidr manual=${CFG[k8s_pod_cidr]}
	else key=service-cidr flag=service-cluster-ip-range manual=${CFG[k8s_service_cidr]}; fi
	if k3s_present; then
		while IFS= read -r f; do files+=("$f"); done < <(k3s_files)
		v=$(yaml_values "$key" "${files[@]+"${files[@]}"}")
		if [[ -n $v ]]; then printf '%s\n' "$v"; found=1; fi
	fi
	if kubeadm_present; then
		v=$(grep -hoE -- "--$flag=[^ \"']+" "$KUBE_MANIFEST_DIR"/*.yaml 2>/dev/null | sed 's/^[^=]*=//' | tr ',' '\n')
		if [[ -n $v ]]; then printf '%s\n' "$v"; found=1; fi
	fi
	# k3s defaults apply when nothing was configured
	if ((found == 0)) && k3s_present && ! kubeadm_present; then
		if [[ $kind == pod ]]; then printf '10.42.0.0/16\n'; else printf '10.43.0.0/16\n'; fi
	fi
	[[ -n $manual ]] && printf '%s\n' "${manual//,/$'\n'}"
	return 0
}

k8s_nodes() { # node addresses, only when kubectl answers
	have kubectl || return 0
	local kc=""
	[[ -r $K3S_DIR/k3s.yaml ]] && kc=$K3S_DIR/k3s.yaml
	KUBECONFIG=${kc:-${KUBECONFIG:-}} timeout 5 kubectl get nodes -o \
		'jsonpath={range .items[*]}{range .status.addresses[*]}{.type}={.address}{"\n"}{end}{end}' 2>/dev/null |
		awk -F= '$1 == "InternalIP" || $1 == "ExternalIP" { print $2 }'
}

ufw_state() { # active | inactive | absent
	if ! have ufw && [[ ! -e $UFW_CONF ]]; then printf 'absent\n'; return; fi
	if have ufw && timeout 3 ufw status 2>/dev/null | grep -q '^Status: active'; then printf 'active\n'; return; fi
	if [[ -r $UFW_CONF ]] && grep -qiE '^ENABLED=yes' "$UFW_CONF"; then printf 'active\n'; return; fi
	printf 'inactive\n'
}

firewalld_state() { # active | inactive | absent
	if ! have firewall-cmd && [[ ! -e $FIREWALLD_CONF ]]; then printf 'absent\n'; return; fi
	if have firewall-cmd && [[ $(timeout 3 firewall-cmd --state 2>/dev/null) == running ]]; then printf 'active\n'; else printf 'inactive\n'; fi
}

firewalld_backend() {
	local b=""
	[[ -r $FIREWALLD_CONF ]] && b=$(sed -n 's/^FirewallBackend=\(.*\)$/\1/p' "$FIREWALLD_CONF" | head -1)
	printf '%s\n' "${b:-nftables}"
}

# Recompute the generated files from what is installed now. Cheap, no daemon is touched.
integrations_refresh() {
	local new_int new_allow old_int old_allow changed=0 n_int n_allow
	mk_tmpdir
	new_int=$TMPD/integ.internal new_allow=$TMPD/integ.allow
	: >"$new_int"
	: >"$new_allow"
	if integ_enabled docker && docker_present; then docker_nets | norm_nets >>"$new_int"; fi
	if integ_enabled k8s && k8s_present; then
		{ k8s_nets pod; k8s_nets service; } | norm_nets >>"$new_int"
		k8s_nodes | norm_nets >>"$new_allow"
	fi
	sort -u -o "$new_int" "$new_int"
	sort -u -o "$new_allow" "$new_allow"
	old_int=$(cat "$INTEG_INTERNAL" 2>/dev/null)
	old_allow=$(cat "$INTEG_ALLOW" 2>/dev/null)
	[[ $old_int == "$(cat "$new_int")" && $old_allow == "$(cat "$new_allow")" ]] && return 0
	mkdir -p -- "$STATE_DIR"
	write_atomic "$INTEG_INTERNAL" <"$new_int"
	write_atomic "$INTEG_ALLOW" <"$new_allow"
	allow_reload_live
	n_int=$(awk 'END { print NR }' "$new_int")
	n_allow=$(awk 'END { print NR }' "$new_allow")
	log_event "integration_changed internal=$n_int nodes=$n_allow"
	return 0
}

integ_status_lines() { # prints the status table
	local n st c
	say integ_mode "${CFG[integrations]}"
	# docker
	if docker_present; then st=$(t st_detected); else st=$(t st_absent); fi
	c=$(docker_nets | norm_nets | sort -u | awk 'END { print NR }')
	say integ_row docker "$st" "$(t integ_d_docker "$c")"
	# k8s
	if k8s_present; then st=$(t st_detected); else st=$(t st_absent); fi
	c=$({ k8s_nets pod; k8s_nets service; } | norm_nets | sort -u | awk 'END { print NR }')
	n=$(k8s_nodes | norm_nets | sort -u | awk 'END { print NR }')
	say integ_row k8s "$st" "$(t integ_d_k8s "$c" "$n")"
	# ufw / firewalld: status only, their rules are never changed
	st=$(ufw_state)
	say integ_row ufw "$(t "st_$st")" "$(t integ_d_ufw "$(t "st_$st")")"
	st=$(firewalld_state)
	say integ_row firewalld "$(t "st_$st")" "$(t integ_d_fwd "$(t "st_$st")" "$(firewalld_backend)")"
}

# D-004: bb integrate none|<name> are additions to the specified CLI
cmd_integrate() {
	local sub=${1:-status} cur
	[[ $# -gt 0 ]] && shift
	need_root; take_lock; load_config
	case $sub in
		status) integ_status_lines; return 0 ;;
		auto | none) cfg_set integrations "$sub" ;;
		docker | k8s | ufw | firewalld)
			cur=${CFG[integrations]}
			if [[ $cur == auto || $cur == none ]]; then cur=$sub
			elif [[ ,$cur, != *,"$sub",* ]]; then cur+=",$sub"; fi
			cfg_set integrations "$cur" ;;
		*) die err_integrate_name "$sub" ;;
	esac
	integrations_refresh
	say integ_updated "${CFG[integrations]}" "$(awk 'END { print NR }' "$INTEG_INTERNAL" 2>/dev/null || printf 0)" "$(awk 'END { print NR }' "$INTEG_ALLOW" 2>/dev/null || printf 0)"
}

# ---- bb doctor -----------------------------------------------------------------------------------
DOC_FAIL=0 DOC_WARN=0 DOC_JSON=0
DOC_ROWS=()
doc() { # level(ok|warn|fail) key args...
	local lvl=$1 lbl
	shift
	case $lvl in
		ok) lbl=$(t doc_lbl_ok) ;;
		warn) lbl=$(t doc_lbl_warn); DOC_WARN=$((DOC_WARN + 1)) ;;
		fail) lbl=$(t doc_lbl_fail); DOC_FAIL=$((DOC_FAIL + 1)) ;;
	esac
	if ((DOC_JSON)); then # stable id (the catalog key without "doc_") and the raw arguments, no text
		local id=${1#doc_}
		shift
		DOC_ROWS+=("$(jq -nc --arg level "$lvl" --arg id "$id" '{level: $level, id: $id, args: $ARGS.positional}' --args -- "$@")")
		return 0
	fi
	printf '[%s] ' "$lbl"
	say "$@"
}

doc_word() { # st_* key: the translated word in text mode, the raw word in --json mode
	if ((DOC_JSON)); then printf '%s' "${1#st_}"; else t "$1"; fi
}

doctor_backend() {
	local missing
	if [[ -z ${CFG[backend]} ]]; then doc fail doc_not_configured; return; fi
	fw_select
	missing=$(fw_missing_list)
	if [[ -z $missing ]]; then doc ok doc_backend_ok "${CFG[backend]}"; else doc fail doc_backend_missing "${CFG[backend]}" "$missing"; return; fi
	if [[ $FW == ipt ]]; then
		if ipset list -n >/dev/null 2>&1; then doc ok doc_kernel_ok ipset; else doc fail doc_kernel_fail ipset; fi
		doc ok doc_variant "$(iptables_variant)"
		if ((IPV6_UNUSABLE)); then doc warn doc_ipv6_unusable; fi
	else
		if nft list tables >/dev/null 2>&1; then doc ok doc_kernel_ok nf_tables; else doc fail doc_kernel_fail nf_tables; fi
	fi
}

doctor_rules() {
	[[ -n $FW ]] || return 0
	if fw_check >/dev/null 2>&1; then doc ok doc_rules_ok; else doc fail doc_rules_fail; fi
}

doctor_units() {
	local u
	if ! have_systemd || ! have systemctl; then doc warn doc_nosystemd; return; fi
	for u in bb-firewall.service bb-update.timer bb-guard.timer; do
		if systemctl is-enabled --quiet "$u" 2>/dev/null; then doc ok doc_unit_ok "$u"; else doc fail doc_unit_fail "$u"; fi
	done
	[[ ${CFG[backend]} == iptables ]] && { if systemctl is-enabled --quiet bb-sets.service 2>/dev/null; then doc ok doc_unit_ok bb-sets.service; else doc fail doc_unit_fail bb-sets.service; fi; }
	for u in bb-guard.timer bb-update.timer; do
		systemctl is-active --quiet "$u" 2>/dev/null || doc warn doc_timer_warn "$u"
	done
}

doctor_allow() {
	local n
	n=$(awk 'END { print NR }' "$ALLOW_FILE" 2>/dev/null || printf 0)
	if ((n > 0)); then doc ok doc_allow_ok "$n"; else doc warn doc_allow_warn; fi
}

doctor_conflicts() {
	local found="" f
	if have systemctl && systemctl is-enabled --quiet nftables.service 2>/dev/null; then
		if [[ -r $NFTABLES_CONF ]] && grep -qE '^[[:space:]]*flush[[:space:]]+ruleset' "$NFTABLES_CONF"; then
			doc warn doc_nft_flush "$NFTABLES_CONF"
		else
			doc ok doc_nft_ok
		fi
	fi
	# other tools use their own objects; list what is there
	if have iptables && iptables -S 2>/dev/null | grep -q 'f2b-'; then found+=" fail2ban"; fi
	if have nft; then
		f=$(nft list tables 2>/dev/null)
		[[ $f == *fail2ban* ]] && found+=" fail2ban"
		[[ $f == *crowdsec* ]] && found+=" crowdsec"
		[[ $f == *ts-* || $f == *tailscale* ]] && found+=" tailscale"
	fi
	have ip && ip -o link show 2>/dev/null | grep -q 'tailscale0' && found+=" tailscale"
	have ip && have iptables && iptables -S 2>/dev/null | grep -q 'ts-input' && found+=" tailscale"
	found=$(printf '%s\n' $found | awk 'NF && !s[$0]++' | tr '\n' ' ')
	[[ -z $found ]] || doc ok doc_others "${found% }"
}

doctor_integrations() {
	local st n
	if docker_present; then
		n=$(docker_nets | norm_nets | sort -u | awk 'END { print NR }')
		doc ok doc_int_docker "$n"
	fi
	if k8s_present; then
		n=$({ k8s_nets pod; k8s_nets service; } | norm_nets | sort -u | awk 'END { print NR }')
		if ((n > 0)); then doc ok doc_int_k8s "$n"; else doc warn doc_k8s_nocidr; fi
	fi
	st=$(ufw_state)
	if [[ $st == active ]]; then
		doc ok doc_int_ufw "$(doc_word st_active)"
		[[ -s $ALLOW_FILE ]] || doc warn doc_ufw_admin
	fi
	st=$(firewalld_state)
	[[ $st == active ]] && doc ok doc_int_fwd "$(firewalld_backend)"
	return 0
}

doctor_selinux() {
	have getenforce || return 0
	local mode n
	mode=$(getenforce 2>/dev/null)
	doc ok doc_selinux "$mode"
	[[ $mode == Enforcing ]] || return 0
	if have ausearch; then
		n=$(ausearch -m avc -ts recent -c bb 2>/dev/null | grep -c '^type=AVC') || true
		((${n:-0} > 0)) && doc warn doc_avc "$n"
	fi
	return 0
}

doctor_files() {
	local f m own l q
	m=$(stat -c %a "$CONF_FILE" 2>/dev/null)
	[[ -z $m || $m == 600 ]] || doc warn doc_conf_perm "$m"
	if [[ -e $NOTIFY_CONF ]]; then
		m=$(stat -c %a "$NOTIFY_CONF")
		own=$(stat -c %u "$NOTIFY_CONF")
		if [[ $m == 600 && $own == 0 ]]; then doc ok doc_perm_ok; else doc fail doc_perm_fail "$m"; fi
		q=$(queue_len)
		((q > 0)) && doc warn doc_queue "$q"
	fi
	for l in en ru; do
		[[ -r $SHARE_DIR/lang/$l.sh ]] || doc fail doc_catalog_fail "$l.sh"
	done
	[[ -r $SHARE_DIR/lang/${CFG[lang]}.sh ]] && doc ok doc_catalog_ok "${CFG[lang]}"
	for f in $SAVED_RULE_FILES; do
		[[ -r $f ]] && grep -qE 'BB_FILTER|(^| )bb_[a-z]' "$f" && doc warn doc_saved_warn "$f"
	done
	return 0
}

doctor_dpi() {
	local u m own ver
	[[ ${CFG[dpi]} == yes ]] || return 0
	if dpi_binary_ok; then
		ver=$(cut -d' ' -f1 "$STATE_DIR/ndpid.version" 2>/dev/null)
		doc ok doc_dpi_bin_ok "${ver:-?}"
	else doc fail doc_dpi_bin_fail "$NDPID_BIN"; fi
	have jq && doc ok doc_dpi_jq_ok || doc fail doc_dpi_jq_fail
	local -a ifs=()
	local i
	mapfile -t ifs < <(iface_list)
	if ((${#ifs[@]} == 0)); then doc fail doc_dpi_iface_empty
	else
		for i in "${ifs[@]}"; do
			if have ip && ! ip link show "$i" >/dev/null 2>&1; then doc fail doc_dpi_iface_missing "$i"; else doc ok doc_dpi_iface_ok "$i"; fi
		done
	fi
	for u in bb bb-ndpid; do getent passwd "$u" >/dev/null 2>&1 || doc fail doc_dpi_user_fail "$u"; done
	if have_systemd && have systemctl; then
		for u in bb-listener.socket bb-ndpid.service; do
			if systemctl is-enabled --quiet "$u" 2>/dev/null; then doc ok doc_unit_ok "$u"; else doc fail doc_unit_fail "$u"; fi
		done
		systemctl is-active --quiet bb-ndpid.service 2>/dev/null || doc warn doc_dpi_notrunning
		for i in "${ifs[@]:1}"; do
			systemctl is-active --quiet "bb-ndpid@$i.service" 2>/dev/null || doc warn doc_dpi_iface_stopped "$i"
		done
	fi
	m=$(stat -c %a "$LISTENER_CONF" 2>/dev/null) own=$(stat -c %U:%G "$LISTENER_CONF" 2>/dev/null)
	if [[ $m == 640 && $own == root:bb ]]; then doc ok doc_dpi_conf_ok; else doc fail doc_dpi_conf_fail "${own:-?} ${m:-?}"; fi
	[[ -d $LISTENER_DIR && $(stat -c %U "$LISTENER_DIR" 2>/dev/null) == bb ]] || doc warn doc_dpi_dir_warn
}

# The flow sets are bounded (flow_maxelem); a full set silently stops taking new flows.
doctor_flows() {
	local kind name n max=${CFG[flow_maxelem]}
	[[ ${CFG[dpi]} == yes && -n $FW ]] || return 0
	while read -r kind name n; do
		[[ $kind == set && $name == flow* && $n =~ ^[0-9]+$ ]] || continue
		if ((n * 100 >= max * 80)); then doc warn doc_flows_full "$name" "$n" "$max"; fi
	done < <(fw_status 2>/dev/null)
	return 0
}

cmd_doctor() {
	json_args doctor "$@"
	DOC_JSON=$JSON
	need_root; cfg_load || true
	[[ -n ${CFG[backend]} ]] && fw_select
	DOC_FAIL=0 DOC_WARN=0 DOC_ROWS=()
	((DOC_JSON)) || say doc_title
	doctor_backend
	doctor_rules
	doctor_units
	doctor_allow
	doctor_conflicts
	doctor_integrations
	doctor_dpi
	doctor_flows
	doctor_selinux
	doctor_files
	if ((DOC_JSON)); then
		printf '%s\n' "${DOC_ROWS[@]}" | jq -s --arg version "$BB_VERSION" --argjson fail "$DOC_FAIL" --argjson warn "$DOC_WARN" \
			'{version: $version, ok: ($fail == 0), fail: $fail, warn: $warn, checks: .}'
	else
		say doc_summary "$DOC_FAIL" "$DOC_WARN"
	fi
	((DOC_FAIL == 0))
}

# ---- bb log ----------------------------------------------------------------------------------------
# D-004: bb log without -f and -n N are additions to the specified CLI
# One stream for the events bb writes to the journal (tag "bb") and the kernel messages its LOG rules
# produce (prefix "bb: "). The journal is the only log; bb keeps no log file of its own (tech.md section 10).
cmd_log() {
	local follow=0 n=50
	while (($#)); do
		case $1 in
			-f | --follow) follow=1 ;;
			-n) shift; is_uint "${1:-}" && (($1 >= 1 && $1 <= 100000)) || die err_log_n; n=$1 ;;
			*) die err_usage log ;;
		esac
		shift
	done
	have journalctl || die err_log_nojournal
	local args=(-o short-iso --no-pager -n "$n")
	((follow)) && args+=(-f)
	# (tag bb) OR (kernel); the awk below keeps only kernel lines that start with the bb: prefix
	journalctl "${args[@]}" -t bb + _TRANSPORT=kernel |
		awk '$3 ~ /^bb(\[[0-9]+\])?:$/ || ($3 == "kernel:" && $4 == "bb:") { print; fflush() }'
	return 0
}

# ---- dynamic layer: the listener and the flow sets (tech.md section 6.4) ------------------------------
# nDPId (running as its own user) writes frames "<5 digits><JSON>" to a unix socket; systemd starts one
# listener per connection. The listener runs as the unprivileged user "bb" with CAP_NET_ADMIN only:
#   frames -> jq (the only JSON parser) -> validated flow lines -> kernel sets.
# Verified against nDPId 1.7: the 5-digit length INCLUDES the JSON's trailing newline.

# jq reads raw lines, so a corrupt line is skipped instead of ending the stream.
LISTENER_JQ='
def v4: type == "string" and test("^[0-9]{1,3}(\\.[0-9]{1,3}){3}$") and (split(".") | all(.[]; tonumber <= 255));
def v6: type == "string" and test("^[0-9A-Fa-f:]{2,39}$") and contains(":");
def port: type == "number" and . == floor and . >= 1 and . <= 65535;
(try fromjson catch empty)
| select(type == "object")
| select(.flow_event_name == "detected" or .flow_event_name == "detection-update")
| select((.ndpi | type) == "object" and (.ndpi.proto | type) == "string" and (.ndpi.proto | ascii_downcase | contains("bittorrent")))
| select(.l4_proto == "tcp" or .l4_proto == "udp")
| select((.src_port | port) and (.dst_port | port))
| (if (.src_ip | v4) and (.dst_ip | v4) then "4" elif (.src_ip | v6) and (.dst_ip | v6) then "6" else empty end) as $f
| "\($f) \(.src_ip),\(.l4_proto):\(.src_port) \(.dst_ip),\(.l4_proto):\(.dst_port)"'

# stdin: the nDPId stream. stdout: one JSON document per line. Any protocol violation ends the
# connection (nDPId reconnects); nothing from the stream is ever executed or interpolated.
listener_frames() {
	local rc
	# One frame is 5 digits and the JSON; the length counts the trailing newline. awk (bytes, under
	# LC_ALL=C) does the framing: it is much faster than bash and still checks every length.
	# A frame that spreads over several lines is joined with spaces until the length is reached.
	awk -v max="${CFG[max_event_size]}" '
		pend { buf = buf " " $0; got += length($0) + 1 }
		!pend {
			if ($0 !~ /^[0-9][0-9][0-9][0-9][0-9]/) exit 3
			len = substr($0, 1, 5) + 0
			if (len < 1 || len > max) exit 4
			buf = substr($0, 6); got = length(buf) + 1
		}
		got == len { print buf; fflush(); pend = 0; next }
		got > len { pend = 0; exit 5 }
		{ pend = 1 }
		END { if (pend) exit 5 }'
	rc=$?
	case $rc in
		3) log_event "listener_frame_error reason=header" ;;
		4) log_event "listener_frame_error reason=length" ;;
		5) log_event "listener_frame_error reason=truncated" ;;
	esac
	((rc == 0))
}

# One validated candidate "fam sip proto sp dip dp" goes into BATCH unless it is a repeat or
# the rate limit is exceeded (then the flow is dropped and rate_limit is raised once a minute).
listener_line() {
	local line=$1 fam sip sp dip dp proto p2 now key minute
	[[ $line =~ ^([46])\ ([0-9A-Fa-f:.]+),(tcp|udp):([0-9]{1,5})\ ([0-9A-Fa-f:.]+),(tcp|udp):([0-9]{1,5})$ ]] || return 0
	fam=${BASH_REMATCH[1]} sip=${BASH_REMATCH[2]} proto=${BASH_REMATCH[3]} sp=${BASH_REMATCH[4]}
	dip=${BASH_REMATCH[5]} p2=${BASH_REMATCH[6]} dp=${BASH_REMATCH[7]}
	[[ $proto == "$p2" ]] || return 0
	sp=$((10#$sp)) dp=$((10#$dp))
	((sp >= 1 && sp <= 65535 && dp >= 1 && dp <= 65535)) || return 0
	[[ $fam == 6 ]] && ! ipv6_on && return 0
	printf -v now '%(%s)T' -1
	key="$fam $sip $proto $sp $dip $dp"
	[[ -n ${SEEN[$key]+x} ]] && ((SEEN[$key] > now)) && return 0
	minute=$((now / 60))
	if ((minute != CUR_MIN)); then CUR_MIN=$minute MIN_COUNT=0 PAUSE_LOGGED=0; fi
	MIN_COUNT=$((MIN_COUNT + 1))
	if ((MIN_COUNT > ${CFG[flow_rate_limit]})); then
		if ((PAUSE_LOGGED == 0)); then
			PAUSE_LOGGED=1
			printf 'rate_limit %s\n' "$now" >>"$LISTENER_DIR/events"
			log_event "rate_limit limit=${CFG[flow_rate_limit]}"
		fi
		return 0
	fi
	((${#SEEN[@]} >= SEEN_MAX)) && SEEN=() # bounded memory
	SEEN[$key]=$((now + $(dur2sec "${CFG[flow_dedup]}s" 2>/dev/null || printf 600)))
	BATCH+=("$fam $sip $proto $sp $dip $dp")
}

# Adds flows: one ipset restore / one nft transaction. Plain "add" refreshes the timeout of an
# element that already exists, on both backends.
flows_apply() { # file ttl
	local file=$1 ttl=$2
	[[ -s $file ]] || return 0
	if [[ $FW == ipt ]]; then
		awk -v t="$ttl" '{ print "add bb_flow_src" $1 " " $3 "," $2 ":" $4 "," $5 " timeout " t
		                   print "add bb_flow_dst" $1 " " $5 "," $2 ":" $6 "," $3 " timeout " t }' "$file" | ipset restore -exist 2>/dev/null
	else
		awk -v t="$ttl" '
			{ f = $1; buf[f] = buf[f] (n[f]++ ? ", " : "") $3 " . " $4 " . " $5 " . " $6 " timeout " t "s"
			  if (n[f] == 500) { print "add element inet bb flow" f " { " buf[f] " }"; n[f] = 0; buf[f] = "" } }
			END { for (f in buf) if (n[f]) print "add element inet bb flow" f " { " buf[f] " }" }' "$file" | nft -f - 2>/dev/null
	fi
}

# Second validation, in bash/awk: canonical form, private and special ranges dropped, the
# allowlist consulted in the kernel set (so it is always current), then one batched apply.
listener_flush() {
	((${#BATCH[@]})) || return 0
	local entry f sip proto sp dip dp sc dc n=0 ttl f6 s6 d6
	local -A CANON=() ALLOWED=()
	mk_tmpdir
	printf '%s\n' "${BATCH[@]}" | awk '{ print $2; print $5 }' |
		awk -v strip=1 -v orig=1 -v minp4=0 -v minp6=0 -v hosts=0 -f "$AWK_NET" >"$TMPD/canon"
	while IFS=$'\t' read -r _ sc dc; do CANON[$dc]=$sc; done <"$TMPD/canon"
	: >"$TMPD/flows"
	for entry in "${BATCH[@]}"; do
		read -r f sip proto sp dip dp <<<"$entry"
		sc=${CANON[$sip]:-} dc=${CANON[$dip]:-}
		[[ -n $sc && -n $dc ]] || continue
		f6=0 s6=0 d6=0
		[[ $f == 6 ]] && f6=1
		[[ $sc == *:* ]] && s6=1
		[[ $dc == *:* ]] && d6=1
		((f6 == s6 && f6 == d6)) || continue # both addresses must belong to the announced family
		if [[ -z ${ALLOWED["$f $sc"]+x} ]]; then
			if set_test allow "$f" "$sc"; then ALLOWED["$f $sc"]=1; else ALLOWED["$f $sc"]=0; fi
		fi
		if [[ -z ${ALLOWED["$f $dc"]+x} ]]; then
			if set_test allow "$f" "$dc"; then ALLOWED["$f $dc"]=1; else ALLOWED["$f $dc"]=0; fi
		fi
		[[ ${ALLOWED["$f $sc"]} == 0 && ${ALLOWED["$f $dc"]} == 0 ]] || continue
		printf '%s %s %s %s %s %s\n' "$f" "$proto" "$sc" "$sp" "$dc" "$dp" >>"$TMPD/flows"
		n=$((n + 1))
	done
	BATCH=()
	((n > 0)) || return 0
	ttl=$(dur2sec "${CFG[flow_ttl]}")
	if flows_apply "$TMPD/flows" "$ttl"; then log_event "flows_added count=$n"; else log_event "flows_apply_failed count=$n"; fi
	return 0
}

listener_apply() { # stdin: "fam src dst" lines from jq
	local line rc last=$SECONDS
	local -A SEEN=()
	SEEN_MAX=100000
	[[ ${BB_TESTING:-} == 1 && ${BB_SEEN_MAX:-} =~ ^[0-9]+$ ]] && SEEN_MAX=$BB_SEEN_MAX # tests only
	local -a BATCH=()
	local CUR_MIN=0 MIN_COUNT=0 PAUSE_LOGGED=0
	while true; do
		IFS= read -r -t 3 line
		rc=$?
		if ((rc == 0)); then listener_line "$line"
		elif ((rc <= 128)); then break; fi # EOF
		if ((${#BATCH[@]} >= 500 || (${#BATCH[@]} > 0 && SECONDS - last >= 3))); then listener_flush; last=$SECONDS; fi
	done
	listener_flush
}

# Started by bb-listener@.service as user bb with stdin = the accepted socket.
cmd___listener() {
	export LC_ALL=C
	have jq || { log_event "listener_error reason=no_jq"; exit 1; }
	TMP_BASE=$LISTENER_DIR
	CONF_FILE=$LISTENER_CONF
	cfg_load || { log_event "listener_error reason=no_config"; exit 1; }
	fw_select
	listener_frames | jq -R -r --unbuffered "$LISTENER_JQ" | listener_apply
}

# Root side: the listener cannot read the notification secrets, so it leaves a note and the
# guard raises the notification. Only an exact, known line format is honoured.
listener_events_flush() {
	local f=$LISTENER_DIR/events line seen=0
	[[ -s $f ]] || return 0
	while IFS= read -r line; do
		[[ $line =~ ^rate_limit\ [0-9]{9,12}$ ]] && seen=1
	done <"$f"
	: >"$f"
	((seen)) && log_event "rate_limit"
	return 0
}

# ---- saving and showing dynamic flows -------------------------------------------------------------------
# One line per element: "<backend>\t<set>\t<entry>\t<seconds left>", after a "# saved <epoch>" header.
flows_dump() { # prints the live flow elements with their remaining seconds
	local f s
	if [[ $FW == ipt ]]; then
		for f in $(fw_families); do
			for s in flow_src flow_dst; do
				ipset list "$(ipt_set "$s" "$f")" 2>/dev/null | awk -v s="$s$f" '
					/^Members:/ { m = 1; next }
					m && NF { t = ""; for (i = 2; i < NF; i++) if ($i == "timeout") t = $(i + 1)
					          if (t != "") printf "ipt\t%s\t%s\t%d\n", s, $1, t }'
			done
		done
	else
		for f in $(fw_families); do
			nft list set inet bb "flow$f" 2>/dev/null | awk -v s="flow$f" '
				function secs(d,   t, n) { t = 0
					while (match(d, /^[0-9]+(ms|d|h|m|s)/)) {
						n = substr(d, 1, RLENGTH); d = substr(d, RLENGTH + 1)
						if (n ~ /ms$/) continue
						u = substr(n, length(n)); v = substr(n, 1, length(n) - 1) + 0
						t += v * (u == "d" ? 86400 : u == "h" ? 3600 : u == "m" ? 60 : 1) }
					return t }
				/elements = \{/ { on = 1 }
				on { txt = txt $0 }
				on && /\}/ { on = 0 }
				END { sub(/^[^{]*\{/, "", txt); sub(/\}[^}]*$/, "", txt); n = split(txt, e, ",")
				      for (i = 1; i <= n; i++) { x = e[i]; gsub(/^[ \t]+|[ \t]+$/, "", x); if (x == "") continue
				        entry = x; sub(/ timeout .*/, "", entry); sub(/ expires .*/, "", entry)
				        left = x; if (match(left, /expires [0-9a-z]+/)) left = secs(substr(left, RSTART + 8, RLENGTH - 8)); else left = 0
				        printf "nft\t%s\t%s\t%d\n", s, entry, left } }'
		done
	fi
}

cmd___save_flows() { # bb-firewall.service ExecStop
	need_root; load_config require
	mkdir -p -- "$STATE_DIR"
	{ printf '# saved %s\n' "$(date +%s)"; flows_dump; } | write_atomic "$FLOWS_SAVE"
}

# Boot: the sets are new and empty, so put the saved flows back with what is left of their TTL.
flows_restore_if_empty() {
	local now saved
	[[ -r $FLOWS_SAVE ]] || return 0
	[[ -z $(flows_dump | head -1) ]] || return 0 # a live flow means this is not a boot
	now=$(date +%s)
	saved=$(sed -n 's/^# saved \([0-9]*\)$/\1/p' "$FLOWS_SAVE" | head -1)
	[[ -n $saved ]] || return 0
	mk_tmpdir
	local elapsed=$((now - saved))
	((elapsed >= 0)) || elapsed=0 # the clock may be behind the saved time right after a boot
	awk -F'\t' -v b="$FW" -v elapsed="$elapsed" '
		$1 == b && $4 - elapsed > 0 && (b == "nft" || $3 ~ /,.*,/) { print $2 "\t" $3 "\t" $4 - elapsed }' "$FLOWS_SAVE" >"$TMPD/flows.restore"
	[[ -s $TMPD/flows.restore ]] || return 0
	if [[ $FW == ipt ]]; then
		awk -F'\t' '{ print "add bb_" $1 " " $2 " timeout " $3 }' "$TMPD/flows.restore" | ipset restore -exist 2>/dev/null
	else
		awk -F'\t' '{ print "add element inet bb " $1 " { " $2 " timeout " $3 "s }" }' "$TMPD/flows.restore" | nft -f - 2>/dev/null
	fi
	return 0
}

cmd_show() {
	local what=${1:-} kind fset entry left count=0 limit=1000
	[[ $what == flows ]] || die err_usage show
	shift
	while (($#)); do
		case $1 in
			--all) limit=0; shift ;;
			--limit) (($# >= 2)) && is_uint "$2" && (($2 >= 1)) || die err_usage show; limit=$2; shift 2 ;;
			*) die err_usage show ;;
		esac
	done
	need_root; load_config require
	while IFS=$'\t' read -r kind fset entry left; do
		count=$((count + 1))
		((count == 1)) && say show_flows_head
		if ((limit == 0 || count <= limit)); then say show_flow_line "$fset" "$entry" "$left"; fi
	done < <(flows_dump)
	((count > 0)) || say show_flows_none
	((limit > 0 && count > limit)) && say show_flows_more "$((count - limit))"
	return 0
}

# ---- DPI: building nDPId, users, filter (tech.md section 11) -----------------------------------------------
NDPID_REF=${NDPID_REF:-1.7} # a tag or a commit; pinned so that the build is reproducible
NDPID_URL=${NDPID_URL:-https://github.com/utoni/nDPId.git}
DPI_DEPS_APT="build-essential git cmake gettext flex bison libtool autoconf automake pkg-config libpcap-dev libjson-c-dev libnuma-dev libpcre2-dev libmaxminddb-dev librrd-dev"
DPI_DEPS_DNF="gcc gcc-c++ make git cmake gettext flex bison libtool autoconf automake pkgconf-pkg-config libpcap-devel json-c-devel numactl-devel pcre2-devel libmaxminddb-devel rrdtool-devel"

# The capture filter that the port mode implies ("all" means no filter).
dpi_bpf_filter() {
	local expr="" item
	[[ ${CFG[ports_mode]} == all ]] && return 0
	local IFS=,
	for item in ${CFG[ports]}; do
		if [[ $item == *-* ]]; then expr+="${expr:+ or }portrange $item"; else expr+="${expr:+ or }port $item"; fi
	done
	if [[ ${CFG[ports_mode]} == only ]]; then printf '(tcp or udp) and (%s)\n' "$expr"; else printf 'not (%s)\n' "$expr"; fi
}

# The option that takes the BPF filter, read from the help of the installed build (-B in 1.7).
ndpid_bpf_flag() {
	"$NDPID_BIN" -h 2>&1 | awk 'tolower($0) ~ /(bpf|pcap filter)/ && match($0, /^[[:space:]]*-[A-Za-z]/) {
		f = substr($0, RSTART, RLENGTH); gsub(/[[:space:]]/, "", f); print f; exit }'
}

dpi_binary_ok() { [[ -x $NDPID_BIN ]] && "$NDPID_BIN" -h 2>&1 | grep -q 'nDPId'; }

# Runs a command with a spinner and the percentage that cmake/make print; the log is kept for errors.
run_step() { # label cmd args...
	local label=$1 pid i=0 pct frames='|/-\'
	shift
	"$@" >>"$DPI_LOG" 2>&1 &
	pid=$!
	if [[ -t 1 ]]; then
		while kill -0 "$pid" 2>/dev/null; do
			pct=$(tail -c 3000 "$DPI_LOG" 2>/dev/null | grep -oE '\[ *[0-9]+%\]' | tail -1 | tr -dc '0-9')
			printf '\r%s %s %s%%   ' "$label" "${frames:i++%4:1}" "${pct:-0}"
			sleep 0.2
		done
		printf '\r%*s\r' 60 ''
	fi
	wait "$pid"
}

# D-007: only the libnDPI submodule is initialised. A recursive clone also fetches example
# submodules that are never built (and live on a second host).
dpi_build() {
	local src before
	if [[ ${BB_TESTING:-} == 1 && -n ${BB_FAKE_NDPID:-} ]]; then
		install -D -m 0755 "$BB_FAKE_NDPID" "$NDPID_BIN" || return 1
		return 0
	fi
	mkdir -p -- "$STATE_DIR"
	: >"$DPI_LOG"
	if [[ ${BB_SKIP_BUILD_DEPS:-} != 1 ]]; then
		before=$(pkgs_snapshot)
		local deps=$DPI_DEPS_APT
		[[ $OS_FAMILY == dnf ]] && deps=$DPI_DEPS_DNF
		# shellcheck disable=SC2086
		run_step "$(t dpi_step_deps)" pkg_install "$OS_FAMILY" $deps || { pkgs_record_new "$before"; return 1; }
		pkgs_record_new "$before"
	fi
	mk_tmpdir
	src=$TMPD/ndpid
	if [[ $NDPID_REF =~ ^[0-9a-f]{7,40}$ ]]; then
		run_step "$(t dpi_step_build)" git clone "$NDPID_URL" "$src" && git -C "$src" checkout -q "$NDPID_REF" || return 1
	else
		run_step "$(t dpi_step_build)" git clone --depth 1 --branch "$NDPID_REF" "$NDPID_URL" "$src" || return 1
	fi
	run_step "$(t dpi_step_build)" git -C "$src" submodule update --init --depth 1 libnDPI ||
		run_step "$(t dpi_step_build)" git -C "$src" submodule update --init libnDPI || return 1
	mkdir -p -- "$src/build"
	run_step "$(t dpi_step_build)" cmake -S "$src" -B "$src/build" -DBUILD_NDPI=ON -DBUILD_EXAMPLES=OFF || return 1
	run_step "$(t dpi_step_build)" make -C "$src/build" -j"$(nproc)" || return 1
	[[ -x $src/build/nDPId ]] || return 1
	install -D -m 0755 "$src/build/nDPId" "$NDPID_BIN" || return 1
	printf '%s %s\n' "$NDPID_REF" "$(git -C "$src" rev-parse HEAD 2>/dev/null)" >"$STATE_DIR/ndpid.version"
	say dpi_built "$NDPID_REF" "$NDPID_BIN"
}

dpi_create_users() {
	local u nologin
	nologin=$(command -v nologin 2>/dev/null || printf '/usr/sbin/nologin')
	for u in bb bb-ndpid; do
		if ! getent passwd "$u" >/dev/null 2>&1; then
			useradd --system --user-group --no-create-home --home-dir /nonexistent --shell "$nologin" "$u" || { err err_dpi_user "$u"; return 1; }
			manifest_add user "$u"
		fi
	done
}

# D-009: the listener runs as the unprivileged user bb and cannot read /etc/bb, so it gets a copy of
# the few settings it needs, and a directory of its own to write to.
listener_conf_write() {
	local k
	mkdir -p -- "$STATE_DIR"
	chmod 0755 "$STATE_DIR"
	install -d -m 0700 "$LISTENER_DIR"
	{
		printf '# generated by bb from bb.conf; read by the listener\n' # bb-lint: ok
		for k in backend ipv6 flow_ttl flow_dedup flow_rate_limit max_event_size; do printf "%s='%s'\n" "$k" "${CFG[$k]}"; done
	} | write_atomic "$LISTENER_CONF"
	if getent group bb >/dev/null 2>&1; then
		chgrp bb "$LISTENER_CONF" && chmod 0640 "$LISTENER_CONF"
		chown bb:bb "$LISTENER_DIR"
	else
		chmod 0644 "$LISTENER_CONF"
	fi
}

