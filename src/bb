#!/usr/bin/env bash
# bb - lightweight CLI blocker for BitTorrent, DHT and blocklists.
# Specification: tech.md. One bash script, no interpreters, no databases.
#
# Layout of this file:
#   1. paths, i18n, output helpers
#   2. utilities (durations, ports, entry normalization), config
#   3. firewall abstraction layer + backends (iptables/ipset, nft)
#   4. data sources: allowlist, manual bans, lists, DHT nodes
#   5. commands and dispatcher

set -uo pipefail
umask 077
shopt -s extglob

BB_VERSION="0.1.0-dev"

# ---------------------------------------------------------------------------
# 1. Paths, i18n, output
# ---------------------------------------------------------------------------
if [[ ${BB_TESTING:-} == 1 ]]; then
	# Test harness only: lets the suite run against a scratch root.
	CONF_DIR=${BB_CONF_DIR:?}
	STATE_DIR=${BB_STATE_DIR:?}
	SHARE_DIR=${BB_SHARE_DIR:?}
	BACKUP_DIR=${BB_BACKUP_DIR:?}
	LOCK_FILE=${BB_LOCK_FILE:?}
	BIN_PATH=${BB_BIN_PATH:-/usr/local/sbin/bb}
	UNIT_DIR=${BB_UNIT_DIR:?}
	OS_RELEASE=${BB_OS_RELEASE:-/etc/os-release}
	SAVED_RULE_FILES=${BB_SAVED_FILES:-}
	RESOLV_FILES=${BB_RESOLV_FILES:-/etc/resolv.conf}
else
	CONF_DIR=/etc/bb
	STATE_DIR=/var/lib/bb
	SHARE_DIR=/usr/share/bb
	BACKUP_DIR=/var/backups/bb
	LOCK_FILE=/run/bb.lock
	BIN_PATH=/usr/local/sbin/bb
	UNIT_DIR=/etc/systemd/system
	OS_RELEASE=/etc/os-release
	SAVED_RULE_FILES="/etc/iptables/rules.v4 /etc/iptables/rules.v6 /etc/sysconfig/iptables /etc/sysconfig/ip6tables /etc/sysconfig/ipset /etc/iptables/ipsets"
	RESOLV_FILES="/etc/resolv.conf /run/systemd/resolve/resolv.conf"
fi
PENDING_FILE=$STATE_DIR/mode.pending
NOTIFY_CONF=$CONF_DIR/notify.conf
NOTIFY_QUEUE=$STATE_DIR/notify.queue
NOTIFY_DEDUP=$STATE_DIR/notify.dedup
NOTIFY_RATE=$STATE_DIR/notify.rate
NOTIFY_SUPP=$STATE_DIR/notify.suppressed
NOTIFY_LOCK=$STATE_DIR/notify.lock
NOTIFY_FLUSH_LOCK=$STATE_DIR/notify.flush.lock
NOTIFY_ALLOW_FILE=$STATE_DIR/notify.allow
DIGEST_SNAP=$STATE_DIR/digest.counters
CONF_FILE=$CONF_DIR/bb.conf
ALLOW_FILE=$CONF_DIR/allow.list
MANUAL_FILE=$CONF_DIR/manual.list
LISTS_D=$CONF_DIR/lists.d
DHT_NODES_FILE=$CONF_DIR/dht.nodes
CACHE_DIR=$STATE_DIR/lists
DHT_CACHE=$STATE_DIR/dht.list
AWK_NET=$SHARE_DIR/net.awk
SELF=$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")

# Entries broader than this are never accepted (a /0 would block everything).
MIN_PREFIX4=8
MIN_PREFIX6=16

declare -A MSG=()
LANG_NOW=en
TMPD=""

# printf-style catalog lookup. A key missing everywhere prints the key itself.
t() {
	local key=$1
	shift
	local fmt=${MSG[$key]-$key}
	# shellcheck disable=SC2059
	printf -- "$fmt" "$@"
}

say() { t "$@"; printf '\n'; }
warn() { { t label_warning; printf ': '; t "$@"; printf '\n'; } >&2; }
err() { { t label_error; printf ': '; t "$@"; printf '\n'; } >&2; }
die() { err "$@"; exit 1; }
# Plain English, used only before a catalog is loaded or when Russian cannot be shown.
raw_warn() { printf 'bb: warning: %s\n' "$*" >&2; } # bb-lint: ok

i18n_load() {
	local lang=$1
	MSG=()
	# shellcheck disable=SC1091
	source "$SHARE_DIR/lang/en.sh" || { printf 'bb: cannot load message catalog\n' >&2; exit 1; } # bb-lint: ok
	if [[ $lang != en && -r $SHARE_DIR/lang/$lang.sh ]]; then
		# shellcheck disable=SC1090
		source "$SHARE_DIR/lang/$lang.sh"
	fi
	# shellcheck disable=SC2034
	LANG_NOW=$lang
}

locale_is_utf8() {
	case ${LC_ALL:-${LC_CTYPE:-${LANG:-}}} in
		*[Uu][Tt][Ff]-8* | *[Uu][Tt][Ff]8*) return 0 ;;
	esac
	return 1
}

log_event() { # stable English event tags for journald: log_event tag [k=v ...]
	if command -v logger >/dev/null 2>&1; then logger -t bb -- "$*" 2>/dev/null; fi
	notify_hook "$*" >/dev/null 2>&1 # best effort: never blocks or fails a firewall operation
	return 0
}

have() {
	# Test hook: a file listing commands to pretend are not installed.
	if [[ ${BB_TESTING:-} == 1 && -r ${BB_TEST_ABSENT_FILE:-/nonexistent} ]] &&
		grep -qxF -- "$1" "$BB_TEST_ABSENT_FILE"; then return 1; fi
	command -v "$1" >/dev/null 2>&1
}

cleanup() {
	[[ -n $TMPD && -d $TMPD ]] && rm -rf -- "$TMPD"
	return 0
}
trap cleanup EXIT

mk_tmpdir() {
	[[ -n $TMPD ]] && return 0
	mkdir -p -- "$STATE_DIR" || die err_mkdir "$STATE_DIR"
	TMPD=$(mktemp -d "$STATE_DIR/tmp.XXXXXX") || die err_mkdir "$STATE_DIR"
}

# ---------------------------------------------------------------------------
# 2. Utilities
# ---------------------------------------------------------------------------
# dur2sec 7d -> 604800. Accepts N, Ns, Nm, Nh, Nd, Nw. Range 1..4294967 (ipset limit).
dur2sec() {
	local s=$1 n u
	[[ $s =~ ^([0-9]{1,9})([smhdw]?)$ ]] || return 1
	n=$((10#${BASH_REMATCH[1]}))
	u=${BASH_REMATCH[2]}
	case $u in
		m) n=$((n * 60)) ;;
		h) n=$((n * 3600)) ;;
		d) n=$((n * 86400)) ;;
		w) n=$((n * 604800)) ;;
	esac
	((n >= 1 && n <= 4294967)) || return 1
	printf '%d\n' "$n"
}

is_uint() { [[ $1 =~ ^[0-9]{1,12}$ ]]; }

# Port list "6881-6889,51413": numbers 1-65535, ranges ascending,
# at most 15 multiport slots (a range takes two).
ports_valid() {
	local list=$1 item a b slots=0
	[[ -n $list ]] || return 1
	local IFS=,
	for item in $list; do
		if [[ $item =~ ^([0-9]{1,5})-([0-9]{1,5})$ ]]; then
			a=$((10#${BASH_REMATCH[1]})) b=$((10#${BASH_REMATCH[2]}))
			((a >= 1 && b <= 65535 && a < b)) || return 1
			slots=$((slots + 2))
		elif [[ $item =~ ^[0-9]{1,5}$ ]]; then
			a=$((10#$item))
			((a >= 1 && a <= 65535)) || return 1
			slots=$((slots + 1))
		else
			return 1
		fi
	done
	((slots <= 15))
}

# Normalize one user-supplied IP or CIDR. Prints "<4|6><TAB><canonical>".
norm_entry() {
	local out
	[[ $1 =~ ^[0-9A-Fa-f:./]+$ ]] || return 1
	out=$(printf '%s\n' "$1" | awk -v strip=0 -v minp4=$MIN_PREFIX4 -v minp6=$MIN_PREFIX6 -v hosts=0 -f "$AWK_NET") || return 1
	[[ $out == [46]$'\t'* && $out != *$'\n'* ]] || return 1
	printf '%s\n' "$out"
}

# ---- configuration --------------------------------------------------------
declare -A CFG=()
CFG_LOADED=0

cfg_defaults() {
	CFG=(
		[lang]=en [backend]='' [install_backend]=nft [mode]=monitor
		[ipv6]=yes [hook_priority]=-310 [list_maxelem]=1048576
		[flow_ttl]=24h [flow_maxelem]=262144 [flow_dedup]=600
		[max_event_size]=1048576 [min_list_ratio]=50 [strip_private]=yes
		[integrations]=auto [guard_interval]=300 [confirm_timeout]=60
		[flow_rate_limit]=1000 [iface]='' [ports_mode]=all [ports]=''
		[list_max_size]=268435456 [resolve_max]=5000 [dpi]=no
		[notify_enabled]=no
		[notify_events]='mode_changed,guard_restored,list_update_failed,list_rejected,service_failed,rate_limit'
		[notify_dedup]=30m [notify_rate_limit]=20 [notify_queue_ttl]=24h [notify_queue_max]=200
		[notify_allow]=yes [notify_proxy]='' [notify_lang]=''
	)
}

cfg_valid() { # key value
	local k=$1 v=$2
	case $k in
		lang) [[ $v == en || $v == ru ]] ;;
		backend) [[ -z $v || $v == iptables || $v == nft ]] ;;
		install_backend) [[ $v == iptables || $v == nft ]] ;;
		mode) [[ $v == monitor || $v == block ]] ;;
		ipv6 | strip_private | dpi | notify_enabled | notify_allow) [[ $v == yes || $v == no ]] ;;
		notify_events) notify_events_valid "$v" ;;
		notify_dedup | notify_queue_ttl) dur2sec "$v" >/dev/null ;;
		notify_rate_limit | notify_queue_max) is_uint "$v" && ((v >= 1)) ;;
		notify_proxy) [[ -z $v || $v =~ ^(https?|socks5h?)://[^[:space:]\"\\]+$ ]] ;;
		notify_lang) [[ -z $v || $v == en || $v == ru ]] ;;
		hook_priority) [[ $v =~ ^-?[0-9]{1,5}$ ]] ;;
		list_maxelem | flow_maxelem | flow_dedup | max_event_size | confirm_timeout | flow_rate_limit | list_max_size | resolve_max)
			is_uint "$v" && ((v >= 1)) ;;
		flow_ttl | guard_interval) dur2sec "$v" >/dev/null ;;
		min_list_ratio) is_uint "$v" && ((v <= 100)) ;;
		integrations) [[ $v =~ ^[a-z0-9,]{1,64}$ ]] ;;
		iface) [[ -z $v || $v =~ ^[A-Za-z0-9_.:@-]{1,64}$ ]] ;;
		ports_mode) [[ $v == only || $v == all || $v == except ]] ;;
		ports) [[ -z $v ]] || ports_valid "$v" ;;
		*) return 1 ;;
	esac
}

# Strict KEY='value' parser; the file is never sourced.
cfg_load() {
	cfg_defaults
	CFG_LOADED=0
	[[ -r $CONF_FILE ]] || return 1
	local line k v n=0
	while IFS= read -r line || [[ -n $line ]]; do
		n=$((n + 1))
		[[ $line =~ ^[[:space:]]*(#.*)?$ ]] && continue
		if [[ $line =~ ^([a-z_][a-z0-9_]*)=\'([^\']*)\'$ ]]; then
			k=${BASH_REMATCH[1]} v=${BASH_REMATCH[2]}
			[[ -v CFG[$k] ]] || continue # unknown keys belong to other components
			if cfg_valid "$k" "$v"; then CFG[$k]=$v; else warn warn_cfg_value "$k" "$n"; fi
		else
			warn warn_cfg_line "$n"
		fi
	done <"$CONF_FILE"
	# shellcheck disable=SC2034
	CFG_LOADED=1
	return 0
}

# Atomic write: .new -> mv, mode 0600. Keeps keys other components own.
cfg_save() {
	local k tmp=$CONF_FILE.new extra=""
	mkdir -p -- "$CONF_DIR" || die err_mkdir "$CONF_DIR"
	if [[ -r $CONF_FILE ]]; then
		while IFS= read -r k; do
			[[ $k =~ ^([a-z_][a-z0-9_]*)= ]] && [[ ! -v CFG[${BASH_REMATCH[1]}] ]] && extra+=$k$'\n'
		done <"$CONF_FILE"
	fi
	{
		printf '# bb configuration - managed by bb, KEY='"'"'value'"'"' lines only\n' # bb-lint: ok
		for k in $(printf '%s\n' "${!CFG[@]}" | sort); do
			printf "%s='%s'\n" "$k" "${CFG[$k]}"
		done
		if [[ -n $extra ]]; then printf '%s' "$extra"; fi
	} >"$tmp" || die err_write "$tmp"
	chmod 0600 "$tmp" && mv -f -- "$tmp" "$CONF_FILE" || die err_write "$CONF_FILE"
}

cfg_set() {
	cfg_valid "$1" "$2" || die err_cfg_invalid "$1" "$2"
	CFG[$1]=$2
	cfg_save
}

effective_lang() { # --lang, BB_LANG, bb.conf, en
	local l=${ARG_LANG:-${BB_LANG:-}}
	[[ -n $l ]] || l=${CFG[lang]:-en}
	[[ $l == en || $l == ru ]] || l=en
	printf '%s\n' "$l"
}

# Atomic replace of a text file from stdin.
write_atomic() { # path
	local path=$1 tmp=$1.new
	cat >"$tmp" || { rm -f -- "$tmp"; return 1; }
	chmod 0600 "$tmp" && mv -f -- "$tmp" "$path"
}

# ---------------------------------------------------------------------------
# 3. Firewall abstraction layer
#    fw_init fw_apply fw_check fw_status fw_remove fw_backup fw_rollback
#    set_replace set_add set_del flow_add
#    The rest of the program never touches a backend directly.
# ---------------------------------------------------------------------------
FW=""

fw_families() {
	printf '4\n'
	[[ ${CFG[ipv6]} == yes ]] && printf '6\n'
	return 0
}

# ---- backend detection (tech.md section 3) -------------------------------
D_IPT=0 D_IPSET=0 D_NFT=0
DETECT_BACKEND="" DETECT_PKGS=""

detect_tools() {
	D_IPT=0 D_IPSET=0 D_NFT=0
	have iptables && D_IPT=1
	if have ipset && ipset list -n >/dev/null 2>&1; then D_IPSET=1; fi
	if have nft && nft list tables >/dev/null 2>&1; then D_NFT=1; fi
	return 0
}

iptables_variant() { # prints nf_tables | legacy | unknown
	local v
	v=$(iptables -V 2>/dev/null) || { printf 'unknown\n'; return; }
	case $v in
		*nf_tables*) printf 'nf_tables\n' ;;
		*legacy*) printf 'legacy\n' ;;
		*) printf 'legacy\n' ;; # old iptables without a variant tag is xtables
	esac
}

# Sets DETECT_BACKEND and DETECT_PKGS (logical package names, may be empty).
detect_backend() {
	detect_tools
	DETECT_PKGS=""
	if ((D_IPT && D_IPSET)); then
		DETECT_BACKEND=iptables
	elif ((D_NFT)); then
		DETECT_BACKEND=nft
	elif ((D_IPT)); then
		DETECT_BACKEND=iptables
		DETECT_PKGS=ipset
	elif [[ ${CFG[install_backend]} == iptables ]]; then
		DETECT_BACKEND=iptables
		DETECT_PKGS="iptables ipset"
	else
		DETECT_BACKEND=nft
		# shellcheck disable=SC2034
		DETECT_PKGS=nftables
	fi
}

fw_select() { # sets FW from bb.conf
	case ${CFG[backend]} in
		iptables) FW=ipt ;;
		nft) FW=nft ;;
		*) die err_not_configured ;;
	esac
}

fw_tools_ok() {
	local missing=""
	if [[ $FW == ipt ]]; then
		local c
		for c in iptables iptables-restore iptables-save ipset; do have "$c" || missing+=" $c"; done
		if [[ ${CFG[ipv6]} == yes ]]; then
			for c in ip6tables ip6tables-restore ip6tables-save; do have "$c" || missing+=" $c"; done
		fi
	else
		have nft || missing+=" nft"
	fi
	[[ -z $missing ]] || { err err_tools_missing "${missing# }"; return 1; }
}

# Dispatchers.
# shellcheck disable=SC2120
fw_init() { "${FW}_init" "$@"; }
# shellcheck disable=SC2120
fw_apply() { "${FW}_apply" "$@"; }
# shellcheck disable=SC2120
fw_check() { "${FW}_check" "$@"; }
# shellcheck disable=SC2120
fw_status() { "${FW}_status" "$@"; }
# shellcheck disable=SC2120
fw_remove() { "${FW}_remove" "$@"; }
fw_backup() { "${FW}_backup" "$@"; }
fw_rollback() { "${FW}_rollback" "$@"; }
set_replace() { "${FW}_set_replace" "$@"; } # kind fam file
set_add() { "${FW}_set_add" "$@"; }         # kind fam entry [ttl_seconds]
set_del() { "${FW}_set_del" "$@"; }         # kind fam entry
flow_add() { "${FW}_flow_add" "$@"; }       # fam src sport dst dport proto ttl

# Ports for the DHT rule, canonical "6881-6889,51413".
dht_port_mode() { printf '%s\n' "${CFG[ports_mode]}"; }

# ---- iptables + ipset backend ----------------------------------------------
ipt_bin() { [[ $1 == 4 ]] && printf 'iptables\n' || printf 'ip6tables\n'; }
ipt_set() { printf 'bb_%s%s\n' "$1" "$2"; } # kind fam

ipt_hashsize() { # element count -> power of two, 1024..4194304
	local n=${1:-0} h=1024
	while ((h * 2 < n && h < 4194304)); do h=$((h * 2)); done
	printf '%d\n' "$h"
}

ipt_set_args() { # kind fam [count]
	local kind=$1 fam=$2 count=${3:-0} f=inet
	[[ $fam == 6 ]] && f=inet6
	case $kind in
		allow) printf 'hash:net family %s maxelem 65536 hashsize 1024\n' "$f" ;;
		manual) printf 'hash:net family %s maxelem 65536 hashsize 1024 timeout 0\n' "$f" ;;
		list) printf 'hash:net family %s maxelem %s hashsize %s\n' "$f" "${CFG[list_maxelem]}" "$(ipt_hashsize "$count")" ;;
		dht) printf 'hash:ip,port family %s maxelem 65536 hashsize 1024\n' "$f" ;;
		flow_src | flow_dst)
			printf 'hash:ip,port family %s maxelem %s hashsize 1024 timeout %s\n' "$f" "${CFG[flow_maxelem]}" "$(dur2sec "${CFG[flow_ttl]}")" ;;
	esac
}

ipt_init() {
	local f kind name
	for f in $(fw_families); do
		for kind in allow manual list dht flow_src flow_dst; do
			name=$(ipt_set "$kind" "$f")
			# shellcheck disable=SC2046
			ipset create -exist "$name" $(ipt_set_args "$kind" "$f") 2>/dev/null ||
				ipset list -n "$name" >/dev/null 2>&1 || { err err_fw_init "$name"; return 1; }
		done
	done
}

ipt_emit() { # category match...
	local cat=$1 m=$2
	if [[ ${CFG[mode]} == block ]]; then
		printf -- '-A BB_FILTER %s -m comment --comment "bb:%s" -j DROP\n' "$m" "$cat"
	else
		printf -- '-A BB_FILTER %s -m comment --comment "bb:%s"\n' "$m" "$cat"
		printf -- '-A BB_FILTER %s -m limit --limit 10/second --limit-burst 20 -j LOG --log-prefix "bb: %s "\n' "$m" "$cat"
		printf -- '-A BB_FILTER %s -j RETURN\n' "$m"
	fi
}

ipt_port_match() { # multiport expression for the DHT rule, or nothing
	local l=${CFG[ports]}
	l=${l//-/:}
	case ${CFG[ports_mode]} in
		only) printf -- '-m multiport --ports %s' "$l" ;;
		except) printf -- '-m multiport ! --ports %s' "$l" ;;
	esac
}

ipt_rules() { # fam -> iptables-restore input (one atomic transaction)
	local f=$1 d mp
	printf '*raw\n:BB_FILTER - [0:0]\n-F BB_FILTER\n'
	printf -- '-A BB_FILTER -i lo -j RETURN\n-A BB_FILTER -o lo -j RETURN\n'
	for d in src dst; do
		printf -- '-A BB_FILTER -m set --match-set bb_allow%s %s -j RETURN\n' "$f" "$d"
	done
	for d in src dst; do ipt_emit manual "-m set --match-set bb_manual$f $d"; done
	for d in src dst; do ipt_emit list "-m set --match-set bb_list$f $d"; done
	mp=$(ipt_port_match)
	for d in dst src; do ipt_emit dht "-p udp -m set --match-set bb_dht$f $d,$d $mp"; done
	ipt_emit flow "-m set --match-set bb_flow_src$f src,src -m set --match-set bb_flow_dst$f dst,dst"
	ipt_emit flow "-m set --match-set bb_flow_src$f dst,dst -m set --match-set bb_flow_dst$f src,src"
	printf 'COMMIT\n'
}

# Exactly one jump to BB_FILTER, first in PREROUTING and OUTPUT of raw.
# The new jump is inserted before the stale ones are deleted: protection never lapses.
ipt_ensure_jump() { # fam
	local bin hook nums n
	bin=$(ipt_bin "$1")
	for hook in PREROUTING OUTPUT; do
		nums=$("$bin" -w -t raw -L "$hook" --line-numbers -n 2>/dev/null | awk '$2 == "BB_FILTER" { print $1 }')
		[[ $nums == 1 ]] && continue
		"$bin" -w -t raw -I "$hook" 1 -j BB_FILTER || return 1
		for n in $(printf '%s\n' $nums | sort -rn); do
			"$bin" -w -t raw -D "$hook" "$((n + 1))" || return 1
		done
	done
}

ipt_apply() {
	local f bin
	mk_tmpdir
	for f in $(fw_families); do
		bin=$(ipt_bin "$f")
		ipt_rules "$f" >"$TMPD/rules$f"
		"${bin}-restore" --test --noflush <"$TMPD/rules$f" || { err err_rules_syntax; return 1; }
	done
	for f in $(fw_families); do
		bin=$(ipt_bin "$f")
		"${bin}-restore" --noflush -w <"$TMPD/rules$f" || return 1
		ipt_ensure_jump "$f" || return 1
	done
}

ipt_check() { # 0 = rules in place and first in order
	local f bin hook first cnt
	for f in $(fw_families); do
		bin=$(ipt_bin "$f")
		"$bin" -w -t raw -S BB_FILTER >/dev/null 2>&1 || return 1
		ipset list -n "$(ipt_set manual "$f")" >/dev/null 2>&1 || return 1
		for hook in PREROUTING OUTPUT; do
			first=$("$bin" -w -t raw -S "$hook" 2>/dev/null | sed -n '2p')
			[[ $first == "-A $hook -j BB_FILTER" ]] || return 1
			cnt=$("$bin" -w -t raw -S "$hook" 2>/dev/null | grep -c -- '-j BB_FILTER$')
			[[ $cnt == 1 ]] || return 1
		done
	done
}

ipt_remove() {
	local f bin hook s
	for f in 4 6; do
		bin=$(ipt_bin "$f")
		have "$bin" || continue
		for hook in PREROUTING OUTPUT; do
			while "$bin" -w -t raw -D "$hook" -j BB_FILTER 2>/dev/null; do :; done
		done
		"$bin" -w -t raw -F BB_FILTER 2>/dev/null
		"$bin" -w -t raw -X BB_FILTER 2>/dev/null
	done
	if have ipset; then
		for s in $(ipset list -n 2>/dev/null | grep '^bb_'); do ipset destroy "$s" 2>/dev/null; done
	fi
	return 0
}

ipt_backup() { # dir
	local d=$1 f bin
	for f in $(fw_families); do
		bin=$(ipt_bin "$f")
		"${bin}-save" -t raw >"$d/${bin}.save" 2>/dev/null
	done
	if have ipset; then
		ipset save 2>/dev/null | awk '$2 ~ /^bb_/' >"$d/ipset.save"
	fi
	return 0
}

ipt_rollback() { # dir: put the chains back as they were
	local d=$1 f bin
	for f in $(fw_families); do
		bin=$(ipt_bin "$f")
		if [[ -s $d/${bin}.save ]] && grep -q '^:BB_FILTER' "$d/${bin}.save"; then
			{
				printf '*raw\n:BB_FILTER - [0:0]\n-F BB_FILTER\n'
				grep '^-A BB_FILTER ' "$d/${bin}.save"
				printf 'COMMIT\n'
			} | "${bin}-restore" --noflush -w 2>/dev/null
		fi
	done
	return 0
}

# Entries file: "entry [timeout_seconds]" per line (dht: "ip,udp:port").
ipt_set_replace() { # kind fam file
	local kind=$1 fam=$2 file=$3 name tmp count
	name=$(ipt_set "$kind" "$fam")
	tmp=bb_tmp_$kind$fam
	count=$(wc -l <"$file")
	ipset destroy "$tmp" >/dev/null 2>&1
	{
		# shellcheck disable=SC2046
		printf 'create %s %s\n' "$tmp" "$(ipt_set_args "$kind" "$fam" "$count")"
		awk -v n="$tmp" '{ if (NF > 1) print "add " n " " $1 " timeout " $2; else print "add " n " " $1 }' "$file"
		printf 'swap %s %s\ndestroy %s\n' "$tmp" "$name" "$tmp"
	} | ipset restore -exist 2>/dev/null
	local rc=$?
	((rc != 0)) && ipset destroy "$tmp" >/dev/null 2>&1
	return "$rc"
}

ipt_set_add() { # kind fam entry [ttl]
	local name
	name=$(ipt_set "$1" "$2")
	if [[ -n ${4:-} ]]; then ipset add -exist "$name" "$3" timeout "$4" 2>/dev/null
	else ipset add -exist "$name" "$3" 2>/dev/null; fi
}

ipt_set_del() { ipset del "$(ipt_set "$1" "$2")" "$3" 2>/dev/null; }

ipt_flow_add() { # fam src sport dst dport proto ttl
	local fam=$1 sip=$2 sp=$3 dip=$4 dp=$5 proto=$6 ttl=$7
	ipset add -exist "$(ipt_set flow_src "$fam")" "$sip,$proto:$sp" timeout "$ttl" 2>/dev/null || return 1
	ipset add -exist "$(ipt_set flow_dst "$fam")" "$dip,$proto:$dp" timeout "$ttl" 2>/dev/null
}

# status output, machine form: "set <name> <count>" and "counter <cat> <pkts> <bytes>"
ipt_status() {
	local f bin kind name n
	for f in $(fw_families); do
		for kind in allow manual list dht flow_src flow_dst; do
			name=$(ipt_set "$kind" "$f")
			n=$(ipset list -t "$name" 2>/dev/null | awk -F': ' '/^Number of entries/ { print $2 }')
			printf 'set %s %s\n' "${kind}${f}" "${n:--}"
		done
	done
	for f in $(fw_families); do
		bin=$(ipt_bin "$f")
		"$bin" -w -t raw -L BB_FILTER -nvx 2>/dev/null
	done | awk '
		match($0, /bb:[a-z]+/) { c = substr($0, RSTART + 3, RLENGTH - 3); p[c] += $1; b[c] += $2 }
		END { for (c in p) printf "counter %s %d %d\n", c, p[c], b[c] }'
}

# ---- nft backend ------------------------------------------------------------
nft_atype() { [[ $1 == 4 ]] && printf 'ipv4_addr\n' || printf 'ipv6_addr\n'; }

nft_prio_name() { # nft prints well-known priorities by name
	case $1 in
		raw) printf -- '-300\n' ;; mangle) printf -- '-150\n' ;; filter) printf '0\n' ;;
		dstnat) printf -- '-100\n' ;; security) printf '50\n' ;; srcnat) printf '100\n' ;;
		*) printf '%s\n' "$1" ;;
	esac
}

# nft may print a priority symbolically ("raw - 10"); stdin: chain listing -> number.
nft_prio_of() {
	local txt base off=0
	txt=$(sed -n 's/.*priority \([^;]*\);.*/\1/p')
	[[ -n $txt ]] || return 1
	# shellcheck disable=SC2086
	set -- $txt
	if [[ $1 =~ ^-?[0-9]+$ ]]; then printf '%s\n' "$1"; return 0; fi
	base=$(nft_prio_name "$1")
	[[ ${2:-} == + ]] && off=${3:-0}
	[[ ${2:-} == - ]] && off=$((-${3:-0}))
	printf '%d\n' "$((base + off))"
}

# A base chain's priority cannot be changed in place: recreate it if it differs.
nft_fix_priority() {
	local hook cur
	for hook in prerouting output; do
		cur=$(nft list chain inet bb "$hook" 2>/dev/null | nft_prio_of) || continue
		[[ $cur == "${CFG[hook_priority]}" ]] && continue
		printf 'flush chain inet bb %s\ndelete chain inet bb %s\n' "$hook" "$hook" | nft -f - || return 1
	done
}

nft_structure() { # idempotent definition of table, sets and chains
	local f a
	printf 'add table inet bb\n'
	for f in $(fw_families); do
		a=$(nft_atype "$f")
		printf 'add set inet bb allow%s { type %s; flags interval; auto-merge; }\n' "$f" "$a"
		printf 'add set inet bb manual%s { type %s; flags interval,timeout; auto-merge; }\n' "$f" "$a"
		printf 'add set inet bb list%s { type %s; flags interval; auto-merge; }\n' "$f" "$a"
		printf 'add set inet bb dht%s { type %s . inet_service; }\n' "$f" "$a"
		printf 'add set inet bb flow%s { type %s . inet_service . %s . inet_service; flags timeout; timeout %ss; size %s; }\n' \
			"$f" "$a" "$a" "$(dur2sec "${CFG[flow_ttl]}")" "${CFG[flow_maxelem]}"
	done
	printf 'add chain inet bb bb_main\nadd chain inet bb bb_dht\n'
	printf 'add chain inet bb prerouting { type filter hook prerouting priority %s; policy accept; }\n' "${CFG[hook_priority]}"
	printf 'add chain inet bb output { type filter hook output priority %s; policy accept; }\n' "${CFG[hook_priority]}"
}

nft_init() {
	nft_fix_priority || return 1
	nft_structure | nft -f - || { err err_fw_init "inet bb"; return 1; }
}

nft_emit() { # category expression [chain]
	local cat=$1 e=$2 c=${3:-bb_main}
	if [[ ${CFG[mode]} == block ]]; then
		printf 'add rule inet bb %s %s counter drop comment "bb:%s"\n' "$c" "$e" "$cat"
	else
		printf 'add rule inet bb %s %s counter comment "bb:%s"\n' "$c" "$e" "$cat"
		printf 'add rule inet bb %s %s limit rate 10/second burst 20 packets log prefix "bb: %s "\n' "$c" "$e" "$cat"
		printf 'add rule inet bb %s %s return\n' "$c" "$e"
	fi
}

nft_ports_set() { local l=${CFG[ports]}; printf '{ %s }' "${l//,/, }"; }

nft_dht_chain() {
	local pl
	pl=$(nft_ports_set)
	printf 'flush chain inet bb bb_dht\n'
	case ${CFG[ports_mode]} in
		all) nft_emit dht "" bb_dht ;;
		except)
			printf 'add rule inet bb bb_dht udp sport %s return\n' "$pl"
			printf 'add rule inet bb bb_dht udp dport %s return\n' "$pl"
			nft_emit dht "" bb_dht ;;
		only)
			nft_emit dht "udp sport $pl" bb_dht
			nft_emit dht "udp dport $pl" bb_dht ;;
	esac
}

nft_rules() {
	local f ip dir
	nft_structure
	printf 'flush chain inet bb bb_main\n'
	printf 'add rule inet bb bb_main iifname "lo" return\n'
	printf 'add rule inet bb bb_main oifname "lo" return\n'
	nft_dht_chain
	for f in $(fw_families); do
		ip=ip
		[[ $f == 6 ]] && ip=ip6
		for dir in saddr daddr; do printf 'add rule inet bb bb_main %s %s @allow%s return\n' "$ip" "$dir" "$f"; done
		for dir in saddr daddr; do nft_emit manual "$ip $dir @manual$f"; done
		for dir in saddr daddr; do nft_emit list "$ip $dir @list$f"; done
		# DHT: the port mode lives in the bb_dht sub-chain. Chained "!=" on adjacent
		# payload fields is merged by nft into one comparison with different
		# meaning, so exemptions are explicit "return" rules instead.
		printf 'add rule inet bb bb_main %s daddr . udp dport @dht%s jump bb_dht\n' "$ip" "$f"
		printf 'add rule inet bb bb_main %s saddr . udp sport @dht%s jump bb_dht\n' "$ip" "$f"
		nft_emit flow "meta l4proto { tcp, udp } $ip saddr . th sport . $ip daddr . th dport @flow$f"
		nft_emit flow "meta l4proto { tcp, udp } $ip daddr . th dport . $ip saddr . th sport @flow$f"
	done
	printf 'flush chain inet bb prerouting\nadd rule inet bb prerouting jump bb_main\n'
	printf 'flush chain inet bb output\nadd rule inet bb output jump bb_main\n'
}

nft_apply() {
	mk_tmpdir
	nft_fix_priority || return 1
	nft_rules >"$TMPD/nft.rules"
	nft -c -f "$TMPD/nft.rules" || { err err_rules_syntax; return 1; }
	nft -f "$TMPD/nft.rules"
}

nft_check() {
	local hook cur
	nft list chain inet bb bb_main >/dev/null 2>&1 || return 1
	for hook in prerouting output; do
		cur=$(nft list chain inet bb "$hook" 2>/dev/null) || return 1
		[[ $cur == *"jump bb_main"* ]] || return 1
		[[ $(nft_prio_of <<<"$cur") == "${CFG[hook_priority]}" ]] || return 1
	done
}

nft_remove() { nft delete table inet bb 2>/dev/null; return 0; }

nft_backup() { nft list table inet bb >"$1/nft.save" 2>/dev/null; return 0; }

nft_rollback() {
	local d=$1
	if [[ -s $d/nft.save ]]; then
		{ printf 'add table inet bb\ndelete table inet bb\n'; cat "$d/nft.save"; } | nft -f - 2>/dev/null
	else
		nft_remove
	fi
}

nft_elem() { # kind entry -> element expression
	local e=$2 ip port
	if [[ $1 == dht ]]; then
		ip=${e%%,*}
		port=${e##*:}
		printf '%s . %s' "$ip" "$port"
	else
		printf '%s' "$e"
	fi
}

nft_set_replace() { # kind fam file
	local kind=$1 fam=$2 file=$3
	{
		printf 'flush set inet bb %s%s\n' "$kind" "$fam"
		awk -v name="$kind$fam" -v kind="$kind" '
			{
				e = $1; to = (NF > 1) ? " timeout " $2 "s" : ""
				if (kind == "dht") { split(e, p, ","); sub(/^[a-z]+:/, "", p[2]); e = p[1] " . " p[2] }
				buf = buf (n ? ", " : "") e to
				if (++n == 500) { print "add element inet bb " name " { " buf " }"; n = 0; buf = "" }
			}
			END { if (n) print "add element inet bb " name " { " buf " }" }' "$file"
	} | nft -f - 2>/dev/null
}

nft_set_add() { # kind fam entry [ttl]
	local el
	el=$(nft_elem "$1" "$3")
	# nft does not refresh the timeout of an existing element: replace it.
	nft delete element inet bb "$1$2" "{ $el }" 2>/dev/null
	if [[ -n ${4:-} ]]; then
		nft add element inet bb "$1$2" "{ $el timeout ${4}s }" 2>/dev/null
	else
		nft add element inet bb "$1$2" "{ $el }" 2>/dev/null
	fi
}

nft_set_del() { nft delete element inet bb "$1$2" "{ $(nft_elem "$1" "$3") }" 2>/dev/null; }

nft_flow_add() { # fam src sport dst dport proto ttl
	local el="$2 . $3 . $4 . $5"
	nft delete element inet bb "flow$1" "{ $el }" 2>/dev/null
	nft add element inet bb "flow$1" "{ $el timeout ${7}s }" 2>/dev/null
}

nft_status() {
	local f kind name n
	for f in $(fw_families); do
		for kind in allow manual list dht flow; do
			name=$kind$f
			n=$(nft list set inet bb "$name" 2>/dev/null) || { printf 'set %s -\n' "$name"; continue; }
			n=$(printf '%s\n' "$n" | awk '
				/elements = \{/ { on = 1 }
				on { s = s $0 }
				on && /\}/ { on = 0 }
				END { if (s == "") { print 0; exit }
				      sub(/^[^{]*\{/, "", s); sub(/\}.*$/, "", s); gsub(/[ \t]/, "", s)
				      print (s == "") ? 0 : gsub(/,/, ",", s) + 1 }')
			printf 'set %s %s\n' "$name" "${n:--}"
		done
	done
	{ nft list chain inet bb bb_main; nft list chain inet bb bb_dht; } 2>/dev/null | awk '
		/counter packets/ && match($0, /comment "bb:[a-z]+"/) {
			c = substr($0, RSTART + 12, RLENGTH - 13)
			split(substr($0, index($0, "counter packets")), a, " ")
			p[c] += a[3]; b[c] += a[5]
		}
		END { for (c in p) printf "counter %s %d %d\n", c, p[c], b[c] }'
}

# ---------------------------------------------------------------------------
# 4. Data sources: allowlist, manual bans, lists, DHT nodes
# ---------------------------------------------------------------------------
fam_of() { [[ $1 == *:* ]] && printf '6\n' || printf '4\n'; }

# Entries of one family from a "entry [x]" file, printing only the entry.
file_family() { # file fam
	[[ -r $1 ]] || return 0
	awk -v f="$2" '{ is6 = index($1, ":") > 0; if ((f == 6) == is6) print $1 }' "$1"
}

manual_family() { # fam -> "entry [remaining_seconds]" for unexpired bans
	[[ -r $MANUAL_FILE ]] || return 0
	awk -v f="$1" -v now="$(date +%s)" '
		$2 != 0 && $2 <= now { next }
		{ is6 = index($1, ":") > 0; if ((f == 6) != is6) next
		  if ($2 == 0) print $1; else print $1, $2 - now }' "$MANUAL_FILE"
}

manual_prune() {
	[[ -r $MANUAL_FILE ]] || return 0
	awk -v now="$(date +%s)" '$2 == 0 || $2 > now' "$MANUAL_FILE" | write_atomic "$MANUAL_FILE"
}

list_entries() { # fam -> union of all list caches
	local f
	for f in "$CACHE_DIR"/*.list; do [[ -r $f ]] && cat -- "$f"; done 2>/dev/null |
		sort -u | awk -v f="$1" '{ is6 = index($1, ":") > 0; if ((f == 6) == is6) print $1 }'
}

dht_entries() { # fam
	[[ -r $DHT_CACHE ]] || return 0
	# the family comes from the address part only ("ip,udp:port" has a colon in the port part)
	awk -v f="$1" '{ split($1, a, ","); is6 = index(a[1], ":") > 0; if ((f == 6) == is6) print $1 }' "$DHT_CACHE"
}

sets_refresh() { # kind: list | dht
	local kind=$1 f rc=0
	mk_tmpdir
	for f in $(fw_families); do
		"${kind}_entries" "$f" >"$TMPD/ent.$kind.$f"
		set_replace "$kind" "$f" "$TMPD/ent.$kind.$f" || { err err_set_load "$kind$f"; rc=1; }
	done
	return "$rc"
}

sets_load_all() {
	local f rc=0
	mk_tmpdir
	manual_prune
	for f in $(fw_families); do
		allow_union "$f" >"$TMPD/allow.$f"
		set_replace allow "$f" "$TMPD/allow.$f" || { err err_set_load "allow$f"; rc=1; }
		manual_family "$f" >"$TMPD/manual.$f"
		set_replace manual "$f" "$TMPD/manual.$f" || { err err_set_load "manual$f"; rc=1; }
	done
	sets_refresh list || rc=1
	sets_refresh dht || rc=1
	return "$rc"
}

# ---- external lists -------------------------------------------------------
L_TYPE="" L_SOURCE="" L_SHA=""

list_name_valid() { [[ $1 =~ ^[a-z0-9][a-z0-9_-]{0,31}$ && $1 != dht ]]; }

list_read() { # name
	local line f=$LISTS_D/$1.conf
	L_TYPE="" L_SOURCE="" L_SHA=""
	[[ -r $f ]] || return 1
	while IFS= read -r line || [[ -n $line ]]; do
		if [[ $line =~ ^(type|source|sha256)=\'([^\']*)\'$ ]]; then
			case ${BASH_REMATCH[1]} in
				type) L_TYPE=${BASH_REMATCH[2]} ;;
				source) L_SOURCE=${BASH_REMATCH[2]} ;;
				sha256) L_SHA=${BASH_REMATCH[2]} ;;
			esac
		fi
	done <"$f"
	[[ $L_TYPE == url || $L_TYPE == file ]] && [[ -n $L_SOURCE ]]
}

list_meta_get() { # name key
	[[ -r $CACHE_DIR/$1.meta ]] || return 0
	sed -n "s/^$2='\\([^']*\\)'\$/\\1/p" "$CACHE_DIR/$1.meta"
}

# fetch_source type source dest -> 0 ok, 1 failed, 2 too big
fetch_source() {
	local type=$1 src=$2 dest=$3 max=${CFG[list_max_size]} sz
	local -a rcs
	if [[ $type == file ]]; then
		[[ -f $src && -r $src ]] || return 1
		head -c "$((max + 1))" -- "$src" >"$dest" || return 1
	else
		[[ $src == https://* ]] || return 1
		if have curl; then
			curl -fsS --proto =https --proto-redir =https --max-time 120 --retry 3 --retry-delay 2 \
				--max-filesize "$max" -o - -- "$src" 2>/dev/null | head -c "$((max + 1))" >"$dest"
		elif have wget; then
			wget -q --https-only --timeout=60 --tries=3 -O - -- "$src" 2>/dev/null | head -c "$((max + 1))" >"$dest"
		else
			return 1
		fi
		rcs=("${PIPESTATUS[@]}")
	fi
	sz=$(stat -c %s "$dest" 2>/dev/null || printf 0)
	((sz > max)) && return 2
	[[ $type == url ]] && ((rcs[0] != 0)) && return 1
	return 0
}

resolve_hosts() { # stdin: host names; stdout: raw addresses (untrusted until normalized)
	local h
	while IFS= read -r h; do
		timeout 5 getent ahosts "$h" 2>/dev/null | awk '{ print $1 }' | sort -u
	done
}

# list_normalize raw out: validated, sanitized, resolved, unique entries.
list_normalize() {
	local raw=$1 out=$2 strip=0
	[[ ${CFG[strip_private]} == yes ]] && strip=1
	awk -v strip=$strip -v minp4=$MIN_PREFIX4 -v minp6=$MIN_PREFIX6 -v hosts=1 -v stats="$TMPD/stats" \
		-f "$AWK_NET" "$raw" >"$TMPD/recs"
	{
		awk -F'\t' '$1 != "H" { print $2 }' "$TMPD/recs"
		awk -F'\t' '$1 == "H" { print $2 }' "$TMPD/recs" | head -n "${CFG[resolve_max]}" | resolve_hosts |
			awk -v strip=$strip -v minp4=0 -v minp6=0 -v hosts=0 -f "$AWK_NET" | awk -F'\t' '{ print $2 }'
	} | sort -u >"$out"
}

# 0 updated, 1 failed, 2 rejected by the safety checks
list_update_one() {
	local name=$1 raw ent new prev rc sha ratio=${CFG[min_list_ratio]}
	list_read "$name" || { warn warn_list_bad_desc "$name"; return 1; }
	mk_tmpdir
	raw=$TMPD/raw.$name ent=$TMPD/ent.$name
	fetch_source "$L_TYPE" "$L_SOURCE" "$raw"
	rc=$?
	if ((rc == 2)); then
		warn warn_list_too_big "$name"; log_event "list_rejected name=$name reason=size"; return 2
	elif ((rc != 0)); then
		warn warn_list_fetch "$name"; log_event "list_update_failed name=$name"; return 1
	fi
	if [[ -n $L_SHA ]]; then
		sha=$(sha256sum "$raw" | cut -d' ' -f1)
		if [[ ${sha,,} != "${L_SHA,,}" ]]; then
			warn warn_list_sha "$name"; log_event "list_update_failed name=$name reason=sha256"; return 1
		fi
	fi
	list_normalize "$raw" "$ent"
	new=$(wc -l <"$ent")
	prev=$(list_meta_get "$name" count)
	prev=${prev:-0}
	if ((new == 0)); then
		warn warn_list_empty "$name"; log_event "list_rejected name=$name reason=empty"; return 2
	fi
	if ((prev > 0 && new * 100 < prev * ratio)); then
		warn warn_list_shrunk "$name" "$prev" "$new"; log_event "list_rejected name=$name reason=shrunk"; return 2
	fi
	mkdir -p -- "$CACHE_DIR"
	mv -f -- "$ent" "$CACHE_DIR/$name.list"
	printf "count='%s'\nupdated='%s'\n" "$new" "$(date +%s)" | write_atomic "$CACHE_DIR/$name.meta"
	say list_updated "$name" "$new"
	log_event "list_updated name=$name entries=$new"
	return 0
}

DHT_DEFAULT_NODES='router.bittorrent.com:6881
router.utorrent.com:6881
dht.transmissionbt.com:6881
dht.libtorrent.org:25401
dht.aelitis.com:6881'

dht_seed_nodes() {
	[[ -e $DHT_NODES_FILE ]] && return 0
	mkdir -p -- "$CONF_DIR"
	{ printf '# DHT bootstrap nodes, one "name:port" (or "ip:port", "[ipv6]:port") per line\n'; # bb-lint: ok
	  printf '%s\n' "$DHT_DEFAULT_NODES"; } | write_atomic "$DHT_NODES_FILE"
}

# 0 updated, 1 failed, 2 rejected
dht_update() {
	local line host port ips ip out new prev ratio=${CFG[min_list_ratio]} strip=0
	[[ ${CFG[strip_private]} == yes ]] && strip=1
	dht_seed_nodes
	mk_tmpdir
	out=$TMPD/dht.new
	: >"$out"
	while IFS= read -r line || [[ -n $line ]]; do
		line=${line%%#*}
		line=${line//[[:space:]]/}
		[[ -n $line ]] || continue
		port=${line##*:}
		host=${line%:*}
		host=${host#[}
		host=${host%]}
		[[ $port =~ ^[0-9]{1,5}$ ]] && ((10#$port >= 1 && 10#$port <= 65535)) || { warn warn_dht_line "$line"; continue; }
		port=$((10#$port))
		if [[ $host =~ ^[0-9A-Fa-f:.]+$ ]]; then
			ips=$host
		elif [[ $host =~ ^[A-Za-z0-9]([A-Za-z0-9_.-]*[A-Za-z0-9])?$ && ${#host} -le 253 ]]; then
			ips=$(printf '%s\n' "$host" | resolve_hosts)
		else
			warn warn_dht_line "$line"; continue
		fi
		# Private/special addresses (incl. IPv4-mapped IPv6) are dropped here.
		while IFS=$'\t' read -r _ ip; do
			[[ -n $ip ]] && printf '%s,udp:%s\n' "$ip" "$port" >>"$out"
		done < <(printf '%s\n' "$ips" | awk -v strip=$strip -v minp4=0 -v minp6=0 -v hosts=0 -f "$AWK_NET")
	done <"$DHT_NODES_FILE"
	sort -u -o "$out" "$out"
	new=$(wc -l <"$out")
	prev=0
	[[ -r $DHT_CACHE ]] && prev=$(wc -l <"$DHT_CACHE")
	if ((new == 0)); then
		warn warn_dht_empty; log_event "list_rejected name=dht reason=empty"; return 2
	fi
	if ((prev > 0 && new * 100 < prev * ratio)); then
		warn warn_dht_shrunk "$prev" "$new"; log_event "list_rejected name=dht reason=shrunk"; return 2
	fi
	mkdir -p -- "$STATE_DIR"
	mv -f -- "$out" "$DHT_CACHE"
	say dht_updated "$new"
	log_event "list_updated name=dht entries=$new"
	return 0
}

# ---------------------------------------------------------------------------
# 5. Commands
# ---------------------------------------------------------------------------
ARG_LANG=""

need_root() { [[ $EUID -eq 0 ]] || die err_need_root; }

take_lock() {
	have flock || die err_tools_missing flock
	mkdir -p -- "$(dirname -- "$LOCK_FILE")"
	exec 9>"$LOCK_FILE" || die err_write "$LOCK_FILE"
	flock -w 30 9 || die err_lock
}

# Load configuration; $1=require -> must be configured (a backend chosen).
load_config() {
	cfg_load || true
	if [[ ${1:-} == require ]]; then
		[[ -n ${CFG[backend]} ]] || die err_not_configured
		fw_select
	elif [[ -n ${CFG[backend]} ]]; then
		fw_select
	fi
}

fw_live() { [[ -n $FW ]] && fw_check >/dev/null 2>&1; }

# A block mode that was never confirmed must not survive a reboot (the rollback
# timer is transient). Called before apply/guard.
mode_check_pending() {
	[[ -e $PENDING_FILE ]] || return 0
	if systemctl is-active --quiet bb-mode-rollback.timer 2>/dev/null; then return 0; fi
	rm -f -- "$PENDING_FILE"
	[[ ${CFG[mode]} == block ]] || return 0
	CFG[mode]=monitor
	cfg_save
	warn warn_mode_reverted
	log_event "mode_changed mode=monitor reason=unconfirmed"
}

# Rebuild everything from configuration; leaves the old state on failure.
do_apply() {
	local bdir=$BACKUP_DIR/last-apply
	fw_tools_ok || return 1
	mk_tmpdir
	rm -rf -- "$bdir"
	mkdir -p -- "$bdir"
	fw_backup "$bdir"
	fw_init || return 1
	if ! sets_load_all; then fw_rollback "$bdir"; return 1; fi
	if ! fw_apply; then
		err err_apply_failed
		fw_rollback "$bdir"
		return 1
	fi
	log_event "apply backend=${CFG[backend]} mode=${CFG[mode]}"
	return 0
}

cmd_apply() {
	need_root; take_lock; load_config require
	mode_check_pending
	do_apply || exit 1
	say apply_done "${CFG[backend]}" "${CFG[mode]}"
}

# Guard: used by bb-guard.timer. Quiet when everything is in place.
cmd_guard() {
	need_root; take_lock; load_config require
	fw_tools_ok || exit 1
	mode_check_pending
	if ! fw_check; then
		log_event "guard_restored backend=${CFG[backend]}"
		do_apply || exit 1
		say guard_restored
	fi
	notify_allow_refresh
	notify_kick # retries queued messages and sends the "suppressed" summary
	return 0
}

# Hidden helper (used by the installer and the tests): write a default bb.conf.
cmd___init_config() {
	need_root; take_lock
	cfg_load || true
	local backend=""
	local v6=""
	while (($#)); do
		case $1 in
			--backend) backend=${2:-}; shift 2 ;;
			--ipv6) v6=${2:-}; shift 2 ;;
			*) die err_unknown_opt "$1" ;;
		esac
	done
	if [[ -z $backend ]]; then detect_backend; backend=$DETECT_BACKEND; fi
	cfg_valid backend "$backend" || die err_cfg_invalid backend "$backend"
	CFG[backend]=$backend
	if [[ -n $v6 ]]; then cfg_valid ipv6 "$v6" || die err_cfg_invalid ipv6 "$v6"; CFG[ipv6]=$v6
	elif [[ -s /proc/net/if_inet6 ]]; then CFG[ipv6]=yes; else CFG[ipv6]=no; fi
	cfg_save
	mkdir -p -- "$LISTS_D" "$STATE_DIR" "$BACKUP_DIR"
	[[ -e $ALLOW_FILE ]] || : >"$ALLOW_FILE"
	[[ -e $MANUAL_FILE ]] || : >"$MANUAL_FILE"
	say config_written "$backend"
}

# entry-file editing shared by ban/allow
entry_file_put() { # file entry expiry|""
	local file=$1 e=$2 x=${3:-}
	{
		[[ -r $file ]] && awk -v e="$e" '$1 != e' "$file"
		if [[ -n $x ]]; then printf '%s %s\n' "$e" "$x"; else printf '%s\n' "$e"; fi
	} | write_atomic "$file"
}

entry_file_del() { # file entry -> 0 if it was present
	local file=$1 e=$2
	[[ -r $file ]] && awk -v e="$e" '$1 == e { f = 1 } END { exit !f }' "$file" || return 1
	awk -v e="$e" '$1 != e' "$file" | write_atomic "$file"
}

cmd_ban() {
	local entry="" ttl="" sec="" exp=0 line fam canon
	while (($#)); do
		case $1 in
			--ttl) (($# >= 2)) || die err_usage ban; ttl=$2; shift 2 ;;
			-*) die err_unknown_opt "$1" ;;
			*) [[ -z $entry ]] || die err_usage ban; entry=$1; shift ;;
		esac
	done
	[[ -n $entry ]] || die err_usage ban
	need_root; take_lock; load_config
	line=$(norm_entry "$entry") || die err_bad_entry "$entry"
	fam=${line%%$'\t'*} canon=${line#*$'\t'}
	if [[ -n $ttl ]]; then
		sec=$(dur2sec "$ttl") || die err_bad_ttl "$ttl"
		exp=$(($(date +%s) + sec))
	fi
	file_family "$ALLOW_FILE" "$fam" | grep -qxF -- "$canon" && warn warn_ban_allowed "$canon"
	entry_file_put "$MANUAL_FILE" "$canon" "$exp" || die err_write "$MANUAL_FILE"
	if [[ $fam == 6 && ${CFG[ipv6]} != yes ]]; then
		: # IPv6 handling is off; the entry is kept in the file only
	elif fw_live; then
		set_add manual "$fam" "$canon" "$sec" || warn warn_set_op "$canon"
	else
		say note_not_applied
	fi
	log_event "manual_change op=ban entry=$canon"
	say ban_done "$canon"
}

cmd_unban() {
	[[ $# -eq 1 && $1 != -* ]] || die err_usage unban
	need_root; take_lock; load_config
	local line fam canon
	line=$(norm_entry "$1") || die err_bad_entry "$1"
	fam=${line%%$'\t'*} canon=${line#*$'\t'}
	entry_file_del "$MANUAL_FILE" "$canon" || die err_not_banned "$canon"
	fw_live && { set_del manual "$fam" "$canon" || true; }
	log_event "manual_change op=unban entry=$canon"
	say unban_done "$canon"
}

cmd_allow() {
	local entry="" rm=0 line fam canon
	while (($#)); do
		case $1 in
			--rm) rm=1; shift ;;
			-*) die err_unknown_opt "$1" ;;
			*) [[ -z $entry ]] || die err_usage allow; entry=$1; shift ;;
		esac
	done
	[[ -n $entry ]] || die err_usage allow
	need_root; take_lock; load_config
	line=$(norm_entry "$entry") || die err_bad_entry "$entry"
	fam=${line%%$'\t'*} canon=${line#*$'\t'}
	if ((rm)); then
		entry_file_del "$ALLOW_FILE" "$canon" || die err_not_allowed "$canon"
		fw_live && { set_del allow "$fam" "$canon" || true; }
		log_event "manual_change op=unallow entry=$canon"
		say allow_removed "$canon"
		return 0
	fi
	entry_file_put "$ALLOW_FILE" "$canon" "" || die err_write "$ALLOW_FILE"
	if fw_live; then
		set_add allow "$fam" "$canon" "" || warn warn_set_op "$canon"
	else
		say note_not_applied
	fi
	log_event "manual_change op=allow entry=$canon"
	say allow_done "$canon"
}

cmd_mode() {
	local want="" confirm="" rollback=0
	while (($#)); do
		case $1 in
			--confirm)
				if [[ ${2:-} =~ ^[0-9]+$ ]]; then confirm=$2; shift 2; else confirm=-1; shift; fi ;;
			--rollback) rollback=1; shift ;;
			-*) die err_unknown_opt "$1" ;;
			*) [[ -z $want ]] || die err_usage mode; want=$1; shift ;;
		esac
	done
	need_root; take_lock; load_config require
	case $want in
		monitor | block) ;;
		confirm)
			rm -f -- "$PENDING_FILE"
			if systemctl stop bb-mode-rollback.timer >/dev/null 2>&1; then say mode_confirmed; else say mode_nothing_pending; fi
			return 0 ;;
		'') say mode_current "${CFG[mode]}"; return 0 ;;
		*) die err_usage mode ;;
	esac
	if [[ $confirm == -1 ]]; then confirm=${CFG[confirm_timeout]}; fi
	[[ $want == block && -n $confirm ]] || confirm=""
	if [[ -n $confirm ]]; then
		have systemd-run || die err_no_systemd_run
		# Arm the rollback first: if the session dies, the timer still fires.
		systemctl stop bb-mode-rollback.timer >/dev/null 2>&1
		systemd-run --quiet --collect --unit=bb-mode-rollback --on-active="${confirm}s" \
			"$SELF" mode monitor --rollback >/dev/null 2>&1 || die err_rollback_arm
		mkdir -p -- "$STATE_DIR"
		date +%s | write_atomic "$PENDING_FILE"
	elif [[ $want == monitor ]]; then
		systemctl stop bb-mode-rollback.timer >/dev/null 2>&1
		rm -f -- "$PENDING_FILE"
	fi
	local old=${CFG[mode]}
	CFG[mode]=$want
	if ! do_apply; then
		CFG[mode]=$old
		[[ -n $confirm ]] && { systemctl stop bb-mode-rollback.timer >/dev/null 2>&1; rm -f -- "$PENDING_FILE"; }
		exit 1
	fi
	cfg_save
	if ((rollback)); then
		log_event "mode_changed mode=$want reason=rollback"
		say mode_rolled_back
		return 0
	fi
	log_event "mode_changed mode=$want"
	say mode_changed "$want"
	if [[ -n $confirm ]]; then
		say mode_confirm_hint "$confirm"
		if [[ -t 0 && -t 1 ]]; then
			local ans=""
			printf '%s ' "$(t mode_confirm_prompt)"
			if read -r -t "$confirm" ans && [[ ${ans,,} == y || ${ans,,} == yes ]]; then
				systemctl stop bb-mode-rollback.timer >/dev/null 2>&1
				rm -f -- "$PENDING_FILE"
				say mode_confirmed
			else
				printf '\n'
				CFG[mode]=monitor
				systemctl stop bb-mode-rollback.timer >/dev/null 2>&1
				rm -f -- "$PENDING_FILE"
				do_apply && cfg_save
				say mode_rolled_back
			fi
		fi
	fi
}

cmd_lang() {
	local want=${1:-}
	cfg_load || true
	if [[ -z $want ]]; then say lang_current "${CFG[lang]}"; return 0; fi
	[[ $want == en || $want == ru ]] || die err_lang_invalid "$want"
	need_root; take_lock
	cfg_set lang "$want"
	i18n_load "$want"
	say lang_set "$want"
}

cmd_status() {
	need_root; load_config require
	local state="absent" l
	fw_live && state=present
	say status_title "$BB_VERSION"
	if [[ $FW == ipt ]]; then say status_backend "iptables ($(iptables_variant))"; else say status_backend nft; fi
	say status_mode "${CFG[mode]}"
	say status_lang "${CFG[lang]}"
	say "status_rules_$state"
	[[ $state == present ]] || return 0
	say status_sets
	local out kind a b c
	out=$(fw_status)
	while read -r kind a b c; do
		[[ $kind == set ]] && say status_set_line "$a" "$b"
	done <<<"$out"
	say status_counters
	while read -r kind a b c; do
		[[ $kind == counter ]] && say status_counter_line "$a" "$b" "$c"
	done < <(sort <<<"$out")
	return 0
}

cmd_list() {
	local sub=${1:-show}
	[[ $# -gt 0 ]] && shift
	case $sub in
		show)
			load_config
			local f n any=0
			for f in "$LISTS_D"/*.conf; do
				[[ -e $f ]] || continue
				n=$(basename -- "$f" .conf)
				list_read "$n" || continue
				say list_line "$n" "$L_TYPE" "$(list_meta_get "$n" count)" "$L_SOURCE"
				any=1
			done
			[[ -r $DHT_CACHE ]] && { say list_line_dht "$(wc -l <"$DHT_CACHE")"; any=1; }
			((any)) || say list_none ;;
		add)
			local name=${1:-} src=${2:-} sha="" ltype
			[[ $# -ge 2 ]] || die err_usage list
			shift 2
			while (($#)); do
				case $1 in
					--sha256) (($# >= 2)) || die err_usage list; sha=$2; shift 2 ;;
					*) die err_unknown_opt "$1" ;;
				esac
			done
			list_name_valid "$name" || die err_bad_listname "$name"
			[[ -z $sha || $sha =~ ^[0-9A-Fa-f]{64}$ ]] || die err_bad_sha
			[[ $src =~ ^[^[:space:]\']+$ ]] || die err_bad_source
			need_root; take_lock; load_config
			case $src in
				https://*) ltype=url ;;
				http://* | ftp://* | *://*) die err_https_only ;;
				*)
					src=$(readlink -f -- "$src") || die err_bad_source
					[[ -f $src && -r $src ]] || die err_bad_source
					ltype='file' ;;
			esac
			mkdir -p -- "$LISTS_D"
			printf "type='%s'\nsource='%s'\nsha256='%s'\n" "$ltype" "$src" "$sha" | write_atomic "$LISTS_D/$name.conf"
			say list_added "$name" ;;
		update)
			need_root; take_lock; load_config
			mk_tmpdir
			local names=() f n rc worst=0 changed=0 dht=0
			if [[ -n ${1:-} ]]; then
				if [[ $1 == dht ]]; then dht=1; else list_name_valid "$1" && [[ -e $LISTS_D/$1.conf ]] || die err_no_list "$1"; names=("$1"); fi
			else
				for f in "$LISTS_D"/*.conf; do [[ -e $f ]] && names+=("$(basename -- "$f" .conf)"); done
				dht=1
			fi
			for n in "${names[@]+"${names[@]}"}"; do
				list_update_one "$n"; rc=$?
				((rc == 0)) && changed=1 || worst=1
			done
			if ((changed)) && [[ -n $FW ]] && fw_live; then sets_refresh list || worst=1; fi
			if ((dht)); then
				dht_update; rc=$?
				if ((rc == 0)); then [[ -n $FW ]] && fw_live && { sets_refresh dht || worst=1; }; else worst=1; fi
			fi
			notify_allow_refresh
			exit "$worst" ;;
		rm)
			[[ $# -eq 1 ]] || die err_usage list
			list_name_valid "$1" && [[ -e $LISTS_D/$1.conf ]] || die err_no_list "$1"
			need_root; take_lock; load_config
			rm -f -- "$LISTS_D/$1.conf" "$CACHE_DIR/$1.list" "$CACHE_DIR/$1.meta"
			[[ -n $FW ]] && fw_live && sets_refresh list
			say list_removed "$1" ;;
		*) die err_usage list ;;
	esac
}

# Hidden helper: add one dynamic flow (the nDPId listener will use flow_add directly).
cmd___flow_add() { # fam src sport dst dport proto [ttl]
	[[ $# -ge 6 ]] || die err_usage __flow-add
	need_root; take_lock; load_config require
	local fam=$1 sip=$2 sp=$3 dip=$4 dp=$5 proto=$6 ttl=${7:-} l
	[[ $fam == 4 || $fam == 6 ]] || die err_usage __flow-add
	[[ $proto == tcp || $proto == udp ]] || die err_usage __flow-add
	for l in "$sp" "$dp"; do
		[[ $l =~ ^[0-9]{1,5}$ ]] && ((10#$l >= 1 && 10#$l <= 65535)) || die err_usage __flow-add
	done
	for l in "$sip" "$dip"; do
		[[ $l != */* ]] && norm_entry "$l" >/dev/null && [[ $(fam_of "$l") == "$fam" ]] || die err_bad_entry "$l"
	done
	[[ -n $ttl ]] || ttl=$(dur2sec "${CFG[flow_ttl]}")
	flow_add "$fam" "$sip" "$((10#$sp))" "$dip" "$((10#$dp))" "$proto" "$ttl" || die err_set_load flow
}

# Hidden helper: remove every bb object (what 'bb uninstall' will do).
cmd___remove() {
	need_root; take_lock; load_config require
	fw_remove
}

# ---- notifications (tech.md section 9) ---------------------------------------------------
NOTIFY_EVENTS_ALL="mode_changed guard_restored list_update_failed list_rejected service_failed rate_limit integration_changed manual_change digest install uninstall"
declare -A NCFG=()

notify_events_valid() { # comma list of known event ids (may be empty)
	local e
	[[ -z $1 ]] && return 0
	local IFS=,
	for e in $1; do
		[[ " $NOTIFY_EVENTS_ALL " == *" $e "* ]] || return 1
	done
}

ncfg_valid() { # key value
	local k=$1 v=$2
	case $k in
		telegram_token) [[ $v =~ ^[0-9]{5,12}:[A-Za-z0-9_-]{20,64}$ ]] ;;
		telegram_chat) [[ $v =~ ^(-?[0-9]{1,20}|@[A-Za-z0-9_]{4,64})$ ]] ;;
		matrix_url) [[ $v =~ ^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~/-]*)?$ ]] ;;
		matrix_token) [[ $v =~ ^[A-Za-z0-9._~+/=-]{8,512}$ ]] ;;
		matrix_room) [[ $v =~ ^![A-Za-z0-9._=/+-]{1,128}:[A-Za-z0-9.-]{1,253}(:[0-9]{1,5})?$ ]] ;;
		*) return 1 ;;
	esac
}

ncfg_load() {
	NCFG=([telegram_token]='' [telegram_chat]='' [matrix_url]='' [matrix_token]='' [matrix_room]='')
	[[ -r $NOTIFY_CONF ]] || return 1
	local line k v
	while IFS= read -r line || [[ -n $line ]]; do
		if [[ $line =~ ^notify_([a-z_]+)=\'([^\']*)\'$ ]]; then
			k=${BASH_REMATCH[1]} v=${BASH_REMATCH[2]}
			[[ -v NCFG[$k] ]] && ncfg_valid "$k" "$v" && NCFG[$k]=$v
		fi
	done <"$NOTIFY_CONF"
	return 0
}

ncfg_save() { # secrets only; root, 0600, atomic
	local k
	mkdir -p -- "$CONF_DIR" || return 1
	{
		printf '# bb notification secrets - root only, never copy into tickets or chats\n' # bb-lint: ok
		for k in telegram_token telegram_chat matrix_url matrix_token matrix_room; do
			printf "notify_%s='%s'\n" "$k" "${NCFG[$k]}"
		done
	} | write_atomic "$NOTIFY_CONF"
}

notify_channels() { # prints configured channels, one per line
	[[ -n ${NCFG[telegram_token]} && -n ${NCFG[telegram_chat]} ]] && printf 'telegram\n'
	[[ -n ${NCFG[matrix_url]} && -n ${NCFG[matrix_token]} && -n ${NCFG[matrix_room]} ]] && have jq && printf 'matrix\n'
	return 0
}

notify_host() { { hostname 2>/dev/null || uname -n; } | tr -cd 'A-Za-z0-9._-' | head -c 64; }

# Quote a string for a curl config file ("-K"): the secrets and the message travel on
# stdin, never on the command line.
curl_q() {
	local s=$1
	s=${s//\\/\\\\}
	s=${s//\"/\\\"}
	s=${s//$'\n'/\\n}
	s=${s//$'\t'/\\t}
	s=${s//$'\r'/\\r}
	printf '%s' "$s"
}

notify_curl_common() {
	printf 'silent\nfail\nmax-time = 10\nconnect-timeout = 10\nproto = "=https"\noutput = "/dev/null"\n'
	[[ -n ${CFG[notify_proxy]} ]] && printf 'proxy = "%s"\n' "$(curl_q "${CFG[notify_proxy]}")"
	return 0
}

# Each sender returns curl's exit code. Nothing secret is ever echoed or logged.
send_telegram() { # text
	local text=${1:0:3900}
	{
		printf 'url = "https://api.telegram.org/bot%s/sendMessage"\n' "${NCFG[telegram_token]}"
		printf 'data-urlencode = "chat_id=%s"\n' "$(curl_q "${NCFG[telegram_chat]}")"
		printf 'data-urlencode = "text=%s"\n' "$(curl_q "$text")"
		notify_curl_common
	} | curl -K - >/dev/null 2>&1
}

send_matrix() { # [txn_id] text  (a retried queue entry reuses its transaction id)
	local txn text json room
	if (($# >= 2)); then txn=$1 text=$2; else text=$1 txn="bb$(date +%s%N)$RANDOM"; fi
	have jq || return 127
	json=$(jq -nc --arg body "${text:0:3900}" '{msgtype: "m.text", body: $body}') || return 1
	room=$(jq -rn --arg v "${NCFG[matrix_room]}" '$v | @uri') || return 1
	{
		printf 'url = "%s/_matrix/client/v3/rooms/%s/send/m.room.message/%s"\n' "${NCFG[matrix_url]%/}" "$room" "$txn"
		printf 'request = "PUT"\n'
		printf 'header = "Authorization: Bearer %s"\n' "${NCFG[matrix_token]}"
		printf 'header = "Content-Type: application/json"\n'
		printf 'data = "%s"\n' "$(curl_q "$json")"
		notify_curl_common
	} | curl -K - >/dev/null 2>&1
}

# ---- message composition (in the notification language) ---------------------------------
kv_get() { # "k=v k=v" key -> sanitized value (untrusted input never reaches a message raw)
	local w
	for w in $1; do
		if [[ $w == "$2="* ]]; then
			w=${w#*=}
			w=${w//[^A-Za-z0-9._@:-]/?}
			printf '%s' "${w:0:64}"
			return 0
		fi
	done
}

notify_lang() { local l=${CFG[notify_lang]:-}; [[ -n $l ]] || l=${CFG[lang]}; printf '%s\n' "$l"; }

# notify_compose event "k=v ..." -> one-line text; digest/test bodies come ready-made.
notify_compose() {
	local ev=$1 rest=$2 body=${3:-} nl host
	nl=$(notify_lang)
	host=$(notify_host)
	(
		i18n_load "$nl"
		local name reason text
		case $ev in
			mode_changed)
				reason=$(kv_get "$rest" reason)
				if [[ -n $reason ]]; then text=$(t ev_mode_reverted "$(kv_get "$rest" mode)")
				else text=$(t ev_mode_changed "$(kv_get "$rest" mode)"); fi ;;
			guard_restored) text=$(t ev_guard_restored) ;;
			list_update_failed) text=$(t ev_list_update_failed "$(kv_get "$rest" name)") ;;
			list_rejected)
				reason=$(kv_get "$rest" reason)
				case $reason in empty | shrunk | size | sha256) reason=$(t "rsn_$reason") ;; *) reason='?' ;; esac
				text=$(t ev_list_rejected "$(kv_get "$rest" name)" "$reason") ;;
			service_failed) text=$(t ev_service_failed "$(kv_get "$rest" unit)") ;;
			rate_limit) text=$(t ev_rate_limit) ;;
			integration_changed) text=$(t ev_integration_changed) ;;
			manual_change)
				name=$(kv_get "$rest" op)
				case $name in ban | unban | allow | unallow) ;; *) name='?' ;; esac # never the address itself
				text=$(t ev_manual_change "$name") ;;
			install) text=$(t ev_install "$(kv_get "$rest" backend)") ;;
			uninstall) text=$(t ev_uninstall) ;;
			test) text=$(t ev_test) ;;
			digest) text=$body ;;
			*) exit 1 ;;
		esac
		if [[ $ev == digest ]]; then
			printf '[%s] %s:\n%s' "$host" "$ev" "$text"
		else
			printf '[%s] %s: %s (%s)' "$host" "$ev" "$text" "$(t msg_footer "${CFG[mode]}" "${CFG[backend]:--}")"
		fi
	)
}

# ---- state: dedup, rate limit, queue ------------------------------------------------------
# All of it lives under $NOTIFY_LOCK, held only for short file edits.
text_key() { printf '%s' "$1" | sha256sum | cut -c1-24; }

queue_len() { [[ -r $NOTIFY_QUEUE ]] && awk 'END { print NR }' "$NOTIFY_QUEUE" || printf '0\n'; }

# notify_enqueue event text [force]: applies dedup + rate limit unless forced.
notify_enqueue() {
	local ev=$1 text=$2 force=${3:-0} now key id b64 cnt dedup limit qmax
	now=$(date +%s)
	dedup=$(dur2sec "${CFG[notify_dedup]}")
	limit=${CFG[notify_rate_limit]}
	qmax=${CFG[notify_queue_max]}
	key=$(text_key "$ev|$text")
	id="$now$RANDOM"
	b64=$(printf '%s' "$text" | base64 -w0)
	mkdir -p -- "$STATE_DIR"
	(
		flock 8
		if ((force == 0)); then
			# dedup: identical events are suppressed for notify_dedup
			if [[ -r $NOTIFY_DEDUP ]]; then
				awk -v n="$now" -v w="$dedup" '$1 > n - w' "$NOTIFY_DEDUP" >"$NOTIFY_DEDUP.new" && mv -f -- "$NOTIFY_DEDUP.new" "$NOTIFY_DEDUP"
				awk -v k="$key" '$2 == k { f = 1 } END { exit !f }' "$NOTIFY_DEDUP" && exit 10
			fi
			printf '%s %s\n' "$now" "$key" >>"$NOTIFY_DEDUP"
			# global limit per hour; the excess is only counted
			if [[ -r $NOTIFY_RATE ]]; then
				awk -v n="$now" '$1 > n - 3600' "$NOTIFY_RATE" >"$NOTIFY_RATE.new" && mv -f -- "$NOTIFY_RATE.new" "$NOTIFY_RATE"
			fi
			cnt=0
			[[ -r $NOTIFY_RATE ]] && cnt=$(awk 'END { print NR }' "$NOTIFY_RATE")
			if ((cnt >= limit)); then
				printf '%s\n' "$(($(cat "$NOTIFY_SUPP" 2>/dev/null || printf 0) + 1))" >"$NOTIFY_SUPP"
				exit 11
			fi
			printf '%s\n' "$now" >>"$NOTIFY_RATE"
		fi
		pending=""
		[[ -n ${NCFG[telegram_token]} && -n ${NCFG[telegram_chat]} ]] && pending=telegram
		if [[ -n ${NCFG[matrix_url]} && -n ${NCFG[matrix_token]} && -n ${NCFG[matrix_room]} ]] && have jq; then pending+=${pending:+,}matrix; fi
		[[ -n $pending ]] || exit 12
		printf '%s\t%s\t%s\t%s\n' "$id" "$now" "$pending" "$b64" >>"$NOTIFY_QUEUE"
		# bounded queue: the oldest messages go first
		if (($(awk 'END { print NR }' "$NOTIFY_QUEUE") > qmax)); then
			tail -n "$qmax" "$NOTIFY_QUEUE" >"$NOTIFY_QUEUE.new" && mv -f -- "$NOTIFY_QUEUE.new" "$NOTIFY_QUEUE"
		fi
		exit 0
	) 8>"$NOTIFY_LOCK"
}

# Deliver what is queued. One flusher at a time; the queue lock is never held during I/O.
notify_flush() {
	have curl || return 0
	mkdir -p -- "$STATE_DIR"
	exec 7>"$NOTIFY_FLUSH_LOCK"
	flock -n 7 || return 0
	ncfg_load || return 0
	local now ttl limit cnt supp id ts pending b64 ch left text rc
	local -a done_ids=() part=()
	now=$(date +%s)
	ttl=$(dur2sec "${CFG[notify_queue_ttl]}")
	limit=${CFG[notify_rate_limit]}

	# the "N notifications suppressed" message goes out once there is room again
	supp=$(cat "$NOTIFY_SUPP" 2>/dev/null || printf 0)
	if ((supp > 0)); then
		cnt=0
		[[ -r $NOTIFY_RATE ]] && cnt=$(awk -v n="$now" '$1 > n - 3600' "$NOTIFY_RATE" | awk 'END { print NR }')
		if ((cnt < limit)); then
			text=$( (i18n_load "$(notify_lang)"; printf '[%s] rate_limit: %s' "$(notify_host)" "$(t msg_suppressed "$supp")") )
			(flock 8; rm -f -- "$NOTIFY_SUPP"; printf '%s\n' "$now" >>"$NOTIFY_RATE") 8>"$NOTIFY_LOCK"
			notify_enqueue summary "$text" 1
		fi
	fi

	[[ -r $NOTIFY_QUEUE ]] || return 0
	local snap
	snap=$(cat "$NOTIFY_QUEUE")
	while IFS=$'\t' read -r id ts pending b64; do
		[[ -n $id ]] || continue
		if ((now - ts > ttl)); then done_ids+=("$id"); continue; fi
		text=$(printf '%s' "$b64" | base64 -d 2>/dev/null) || { done_ids+=("$id"); continue; }
		left=""
		for ch in ${pending//,/ }; do
			rc=1
			case $ch in
				telegram) send_telegram "$text"; rc=$? ;;
				matrix) send_matrix "bb$id" "$text"; rc=$? ;;
			esac
			((rc == 0)) || left+=${left:+,}$ch
		done
		if [[ -z $left ]]; then done_ids+=("$id"); elif [[ $left != "$pending" ]]; then part+=("$id=$left"); fi
	done <<<"$snap"
	((${#done_ids[@]} + ${#part[@]} > 0)) || return 0
	(
		flock 8
		[[ -r $NOTIFY_QUEUE ]] || exit 0
		awk -F'\t' -v OFS='\t' -v done="${done_ids[*]}" -v part="${part[*]}" '
			BEGIN { n = split(done, a, " "); for (i = 1; i <= n; i++) d[a[i]] = 1
			        m = split(part, b, " "); for (i = 1; i <= m; i++) { split(b[i], kv, "="); p[kv[1]] = kv[2] } }
			$1 in d { next }
			$1 in p { $3 = p[$1] }
			{ print }' "$NOTIFY_QUEUE" >"$NOTIFY_QUEUE.new" && mv -f -- "$NOTIFY_QUEUE.new" "$NOTIFY_QUEUE"
	) 8>"$NOTIFY_LOCK"
	return 0
}

# Run the flusher without holding anything of ours: the caller's lock (fd 9) is closed
# in the child so a slow or dead network can never delay a firewall command.
notify_kick() {
	if [[ ${BB_TESTING:-} == 1 && ${BB_NOTIFY_SYNC:-} == 1 ]] || [[ ${NOTIFY_SYNC:-} == 1 ]]; then
		notify_flush
		return 0
	fi
	have curl || return 0
	"$SELF" __notify-flush 9>&- </dev/null >/dev/null 2>&1 &
	disown 2>/dev/null
	return 0
}

notify_hook() { # "event k=v ..." [ready-made body]
	local ev=${1%% *} rest="" text
	[[ $1 == *" "* ]] && rest=${1#* }
	[[ ${CFG[notify_enabled]:-no} == yes ]] || return 0
	[[ ,${CFG[notify_events]}, == *,"$ev",* ]] || return 0
	ncfg_load || return 0
	[[ -n $(notify_channels) ]] || return 0
	text=$(notify_compose "$ev" "$rest" "${2:-}") || return 0
	notify_enqueue "$ev" "$text" 0 || return 0
	notify_kick
}

# ---- keep the notification endpoints reachable ---------------------------------------------
allow_union() { # fam -> manual allowlist plus generated entries
	{ file_family "$ALLOW_FILE" "$1"; file_family "$NOTIFY_ALLOW_FILE" "$1"; } | sort -u
}

notify_allow_reload() { # push allow.list + generated entries into the live sets
	local f
	[[ -n $FW ]] && fw_live || return 0
	mk_tmpdir
	for f in $(fw_families); do
		allow_union "$f" >"$TMPD/allow.live.$f"
		set_replace allow "$f" "$TMPD/allow.live.$f" || true
	done
}

notify_allow_refresh() { # best effort, needs DNS
	local hosts="" h tmp
	if ! ncfg_load || [[ ${CFG[notify_enabled]} != yes || ${CFG[notify_allow]} != yes ]]; then
		[[ -e $NOTIFY_ALLOW_FILE ]] && { rm -f -- "$NOTIFY_ALLOW_FILE"; notify_allow_reload; }
		return 0
	fi
	[[ -n ${NCFG[telegram_token]} ]] && hosts=api.telegram.org
	if [[ -n ${NCFG[matrix_url]} ]]; then
		h=${NCFG[matrix_url]#https://}
		h=${h%%/*}
		hosts+=" ${h%%:*}"
	fi
	mk_tmpdir
	tmp=$TMPD/notify.allow
	: >"$tmp"
	for h in $hosts; do
		timeout 5 getent ahosts "$h" 2>/dev/null | awk '{ print $1 }' | sort -u |
			awk -v strip=0 -v minp4=0 -v minp6=0 -v hosts=0 -f "$AWK_NET" | awk -F'\t' '{ print $2 }' >>"$tmp"
	done
	[[ -s $tmp ]] || return 0 # keep the previous addresses when DNS fails
	sort -u "$tmp" | write_atomic "$NOTIFY_ALLOW_FILE"
	notify_allow_reload
}

# ---- daily digest ---------------------------------------------------------------------------
digest_body() { # in the notification language; no addresses, no secrets
	local out kind a b c f n line cur dp="" ev="" evn
	out=$(fw_status 2>/dev/null)
	(
		i18n_load "$(notify_lang)"
		t dg_mode "${CFG[mode]}" "${CFG[backend]}"; printf '\n'
		line=""
		while read -r kind a b c; do [[ $kind == set ]] && line+="$a=$b "; done <<<"$out"
		t dg_sets "${line% }"; printf '\n'
		declare -A prev=()
		if [[ -r $DIGEST_SNAP ]]; then while read -r a b; do prev[$a]=$b; done <"$DIGEST_SNAP"; fi
		while read -r kind a b c; do
			[[ $kind == counter ]] || continue
			cur=$b
			n=$((cur - ${prev[$a]:-0}))
			((n < 0)) && n=$cur # counters restart when the rules are rebuilt
			dp+="$a=$n "
		done < <(sort <<<"$out")
		t dg_packets "${dp% }"; printf '\n'
		line=""
		for f in "$CACHE_DIR"/*.meta; do
			[[ -e $f ]] || continue
			a=$(basename -- "$f" .meta)
			[[ $a =~ ^[a-z0-9][a-z0-9_-]{0,31}$ ]] || continue
			line+="$a=$(list_meta_get "$a" count) "
		done
		[[ -r $DHT_CACHE ]] && line+="dht=$(awk 'END { print NR }' "$DHT_CACHE") "
		t dg_lists "${line:--}"; printf '\n'
		if have journalctl; then
			for evn in guard_restored list_update_failed list_rejected; do
				n=$(journalctl -t bb --since "24 hours ago" -o cat 2>/dev/null | grep -c "^$evn" || true)
				ev+="$evn=${n:-0} "
			done
			t dg_events "${ev% }"
		fi
	)
	# remember the counters for the next digest
	while read -r kind a b c; do [[ $kind == counter ]] && printf '%s %s\n' "$a" "$b"; done <<<"$out" | write_atomic "$DIGEST_SNAP"
}

digest_timer_sync() {
	have_systemd || return 0
	if [[ ${CFG[notify_enabled]} == yes && ,${CFG[notify_events]}, == *,digest,* ]]; then
		systemctl enable --now bb-digest.timer >/dev/null 2>&1
	else
		systemctl disable --now bb-digest.timer >/dev/null 2>&1
	fi
	return 0
}

cmd___digest() {
	need_root; load_config require
	notify_hook "digest" "$(digest_body)"
}

cmd___notify_flush() { need_root; cfg_load || true; notify_flush; }

cmd___notify_event() { # ev [k=v ...]: used by bb-notify-failure@.service
	[[ $# -ge 1 ]] || die err_usage __notify-event
	need_root; load_config
	notify_hook "$*"
}

# ---- CLI: bb notify ----------------------------------------------------------------------------
read_secret() { # prompt-key -> value on stdout (silent on a terminal)
	local v=""
	if [[ -t 0 ]]; then read -r -s -p "$(t "$1") " v; printf '\n' >&2; else read -r v || true; fi
	printf '%s\n' "$v"
}

read_plain() {
	local v=""
	if [[ -t 0 ]]; then read -r -p "$(t "$1") " v; else read -r v || true; fi
	printf '%s\n' "$v"
}

telegram_detect_chat() { # needs jq; the user has written to the bot
	have jq || die err_notify_jq Telegram
	local cfg out
	cfg=$(printf 'url = "https://api.telegram.org/bot%s/getUpdates"\n' "${NCFG[telegram_token]}"; notify_curl_common | grep -v '^output')
	out=$(printf '%s\n' "$cfg" | curl -K - 2>/dev/null) || return 1
	jq -r '[.result[]? | (.message // .channel_post // .my_chat_member // empty) | .chat.id] | last // empty' <<<"$out" 2>/dev/null
}

cmd_notify_setup() {
	local ch=${1:-} v rc
	need_root; take_lock; load_config
	have curl || die err_tools_missing curl
	ncfg_load || true
	case $ch in
		telegram)
			v=$(read_secret notify_setup_token)
			ncfg_valid telegram_token "$v" || die err_notify_bad_value token
			NCFG[telegram_token]=$v
			v=$(read_plain notify_setup_chat)
			if [[ -z $v ]]; then
				say notify_setup_chat_wait
				[[ -t 0 ]] && read -r _
				v=$(telegram_detect_chat) || v=""
				[[ -n $v ]] || die err_notify_chat_detect
			fi
			ncfg_valid telegram_chat "$v" || die err_notify_bad_value chat
			NCFG[telegram_chat]=$v ;;
		matrix)
			have jq || die err_notify_jq Matrix
			v=$(read_plain notify_setup_url); v=${v%/}
			ncfg_valid matrix_url "$v" || die err_notify_bad_value url
			NCFG[matrix_url]=$v
			v=$(read_secret notify_setup_mtoken)
			ncfg_valid matrix_token "$v" || die err_notify_bad_value token
			NCFG[matrix_token]=$v
			v=$(read_plain notify_setup_room)
			ncfg_valid matrix_room "$v" || die err_notify_bad_value room
			NCFG[matrix_room]=$v ;;
		*) die err_usage notify ;;
	esac
	CFG[notify_enabled]=yes # the test below needs the proxy setting, not the flag
	say notify_testing
	if [[ $ch == telegram ]]; then send_telegram "$(notify_compose test "")"; rc=$?; else send_matrix "$(notify_compose test "")"; rc=$?; fi
	if ((rc != 0)); then
		CFG[notify_enabled]=no
		die err_notify_test_failed "$ch" "$rc"
	fi
	ncfg_save || die err_write "$NOTIFY_CONF"
	cfg_save
	notify_allow_refresh
	digest_timer_sync
	say notify_saved "$ch"
}

cmd_notify_test() {
	need_root; load_config
	have curl || die err_tools_missing curl
	ncfg_load || die err_notify_none
	local ch bad=0 rc txt
	[[ -n $(notify_channels) ]] || die err_notify_none
	txt=$(notify_compose test "")
	for ch in $(notify_channels); do
		if [[ $ch == telegram ]]; then send_telegram "$txt"; rc=$?; else send_matrix "$txt"; rc=$?; fi
		if ((rc == 0)); then say notify_test_ok "$ch"; else warn warn_notify_test_failed "$ch" "$rc"; bad=1; fi
	done
	exit "$bad"
}

cmd_notify_status() {
	need_root; load_config
	local st=off ch
	[[ ${CFG[notify_enabled]} == yes ]] && st=on
	ncfg_load || true
	say ns_state "$(t "word_$st")"
	for ch in telegram matrix; do
		if [[ $(notify_channels) == *"$ch"* ]]; then say ns_channel "$ch" "$(t word_configured)"; else say ns_channel "$ch" "$(t word_not_configured)"; fi
	done
	say ns_events "${CFG[notify_events]:--}"
	say ns_queue "$(queue_len)" "$(cat "$NOTIFY_SUPP" 2>/dev/null || printf 0)"
}

cmd_notify() {
	local sub=${1:-status}
	[[ $# -gt 0 ]] && shift
	case $sub in
		setup) cmd_notify_setup "$@" ;;
		test) cmd_notify_test "$@" ;;
		status) cmd_notify_status "$@" ;;
		enable)
			need_root; take_lock; load_config
			ncfg_load || die err_notify_none
			[[ -n $(notify_channels) ]] || die err_notify_none
			cfg_set notify_enabled yes; notify_allow_refresh; digest_timer_sync; say notify_enabled ;;
		disable)
			need_root; take_lock; load_config
			cfg_set notify_enabled no; notify_allow_refresh; digest_timer_sync; say notify_disabled ;;
		events)
			need_root; take_lock; load_config
			if [[ $# -eq 0 ]]; then say ns_events "${CFG[notify_events]:--}"; return 0; fi
			local e
			for e in ${1//,/ }; do [[ " $NOTIFY_EVENTS_ALL " == *" $e "* ]] || die err_notify_event "$e"; done
			cfg_set notify_events "$1"; digest_timer_sync; say ns_events "${CFG[notify_events]:--}" ;;
		*) die err_usage notify ;;
	esac
}

