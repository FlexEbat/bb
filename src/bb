Before=docker.service k3s.service
$wants

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=$bin apply
$HARDEN

[Install]
WantedBy=multi-user.target
EOF
			;;
		bb-update.service)
			cat <<EOF
