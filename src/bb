# The command line of one nDPId instance (the interface is a name or the unit's %i).
# D-010: verified on nDPId 1.7: started as an unprivileged user it tries to switch to "nobody" and
# exits unless -u/-g name its own user; it opens one collector connection per reader thread
# (10 by default), so the threads are capped to fit the socket's connection limit.
ndpid_cmd() { # interface alias
	local cmd="$NDPID_BIN -i $1 -c /run/bb/ndpid.sock -u bb-ndpid -g bb-ndpid -a $2 -o max-reader-threads=4" filter flag
	filter=$(dpi_bpf_filter)
	if [[ -n $filter ]]; then
		flag=$(ndpid_bpf_flag 2>/dev/null)
		[[ -n $flag ]] && cmd+=" $flag \"$filter\""
	fi
	printf '%s' "$cmd"
}

# One nDPId process watches one interface: the first one is bb-ndpid.service, every other one is an
# instance of bb-ndpid@.service that belongs to it (PartOf), so that the one name starts and stops all.
unit_text() { # name
	local bin=$BIN_PATH wants="" guard onfail="OnFailure=bb-notify-failure@%n.service" ndpid ndpid_wants="" nif=1 i
	local -a ifs=()
	mapfile -t ifs < <(iface_list)
	((${#ifs[@]} > 0)) && nif=${#ifs[@]}
	for i in "${ifs[@]:1}"; do ndpid_wants+=" bb-ndpid@$i.service"; done
	[[ -z $ndpid_wants ]] || ndpid_wants="Wants=${ndpid_wants# }"
	ndpid=$(ndpid_cmd "${ifs[0]:-lo}" bb)
	guard=$(dur2sec "${CFG[guard_interval]}")
	[[ ${CFG[backend]} == iptables ]] && wants="Wants=bb-sets.service"
	case $1 in
		bb-sets.service)
			cat <<EOF
[Unit]
Description=bb: create firewall sets from the local cache
DefaultDependencies=no
After=local-fs.target systemd-modules-load.service
Before=netfilter-persistent.service iptables.service ip6tables.service ufw.service network-pre.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
